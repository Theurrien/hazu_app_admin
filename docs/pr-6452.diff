@@ -0,0 +1,93 @@
+import { Item } from "@shared/model/Item";
+
+export interface AdminPanelData {
+  firstLevelData: Item[];
+  templateData: Item[];
+  usertypeData: Item[];
+  hazuData: Record<string, Item[]>;
+  templateChildrenData: Record<string, Item[]>; // Children of templates for tree view
+  templateRoot: string;
+  parentId: string;
+  env: string;
+}
+
+// Tag Management types
+export type ShareRole = "owner" | "admin" | "editor" | "reader" | "none";
+export type UpdateMode = "template" | "existing" | "both";
+
+export interface TypeCategory {
+  item: Item;
+  configTag: string; // e.g., "hz-config-room-class"
+  templates: TemplateWithChildren[];
+}
+
+export interface TemplateWithChildren {
+  template: Item;
+  children: Item[];
+}
+
+export interface AddGroupForm {
+  type: string;
+  template: string;
+  title: string;
+}
+
+export interface AddUserForm {
+  type: string;
+  template: string;
+  firstName: string;
+  lastName: string;
+  email: string;
+  classes: Record<string, { selected: boolean; userType: string }>;
+  guardian1Email: string;
+  guardian2Email: string;
+  sendInvitationMail: boolean;
+}
+
+export interface AdminPanelState {
+  viewMode: "modal" | "closed";
+  activeTab: "overview" | "add-group" | "add-user" | "group-management";
+  isLoading: boolean;
+  data: AdminPanelData | null;
+  baseItem: Item | null;
+  forms: {
+    addGroup: AddGroupForm;
+    addUser: AddUserForm;
+  };
+  errors: string[];
+  isInitialized: boolean;
+  expandedTreeNodes: string[]; // For tag management tree view
+  selectedUpdateMode: UpdateMode;
+  updatingRoles: string[]; // Array of "itemId-usertype" keys being updated
+}
+
+export const adminPanelInitialState: AdminPanelState = {
+  viewMode: "closed",
+  activeTab: "overview",
+  isLoading: false,
+  data: null,
+  baseItem: null,
+  forms: {
+    addGroup: {
+      type: "",
+      template: "",
+      title: "",
+    },
+    addUser: {
+      type: "",
+      template: "",
+      firstName: "",
+      lastName: "",
+      email: "",
+      classes: {},
+      guardian1Email: "",
+      guardian2Email: "",
+      sendInvitationMail: false,
+    },
+  },
+  errors: [],
+  isInitialized: false,
+  expandedTreeNodes: [],
+  selectedUpdateMode: "both",
+  updatingRoles: [],
+};
