+
+    // Build tree data from admin data
+    this.treeData = computed(() => {
+      const firstLevel = this.firstLevelData();
+      const templates = this.templateData();
+      const templateChildren = this.templateChildrenData();
+
+      // Get items with hz-config-room-... or hz-config-profile-... tags
+      const typeCategories = firstLevel.filter(
+        (item) =>
+          item.tags?.some(
+            (tag) =>
+              tag.startsWith("hz-config-room-") ||
+              tag.startsWith("hz-config-profile-"),
+          ),
+      );
+
+      // For each type category, find matching templates
+      return typeCategories.map((category) => {
+        const configTag = category.tags?.find(
+          (tag) =>
+            tag.startsWith("hz-config-room-") ||
+            tag.startsWith("hz-config-profile-"),
+        );
+
+        const matchingTemplates = templates.filter(
+          (t) => t.tags?.includes(configTag || ""),
+        );
+
+        // Each template's children are loaded from templateChildrenData
+        return {
+          item: category,
+          configTag: configTag || "",
+          templates: matchingTemplates.map((t) => ({
+            template: t,
+            children: templateChildren[t.key] || [],
+          })),
+        };
+      });
+    });
+  }
