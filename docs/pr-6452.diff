+import { createFeatureSelector, createSelector } from "@ngrx/store";
+import { AdminPanelState } from "./admin-panel.state";
+
+export const selectAdminPanelState =
+  createFeatureSelector<AdminPanelState>("adminPanel");
+
+export const selectAdminPanelViewMode = createSelector(
+  selectAdminPanelState,
+  (state) => state.viewMode,
+);
+
+export const selectAdminPanelActiveTab = createSelector(
+  selectAdminPanelState,
+  (state) => state.activeTab,
+);
+
+export const selectAdminPanelIsLoading = createSelector(
+  selectAdminPanelState,
+  (state) => state.isLoading,
+);
+
+export const selectAdminPanelData = createSelector(
+  selectAdminPanelState,
+  (state) => state.data,
+);
+
+export const selectAdminPanelAddGroupForm = createSelector(
+  selectAdminPanelState,
+  (state) => state.forms.addGroup,
+);
+
+export const selectAdminPanelAddUserForm = createSelector(
+  selectAdminPanelState,
+  (state) => state.forms.addUser,
+);
+
+export const selectAdminPanelErrors = createSelector(
+  selectAdminPanelState,
+  (state) => state.errors,
+);
+
+export const selectAdminPanelIsInitialized = createSelector(
+  selectAdminPanelState,
+  (state) => state.isInitialized,
+);
+
+export const selectAdminPanelBaseItem = createSelector(
+  selectAdminPanelState,
+  (state) => state.baseItem,
+);
+
+// Derived selectors
+// Note: Deduplication is now handled at the source in AdminPanelService
+export const selectAdminPanelFirstLevelData = createSelector(
+  selectAdminPanelData,
+  (data) => data?.firstLevelData ?? [],
+);
+
+export const selectAdminPanelTemplateData = createSelector(
+  selectAdminPanelData,
+  (data) => data?.templateData ?? [],
+);
+
+// Note: Deduplication is now handled at the source in AdminPanelService
+export const selectAdminPanelUsertypeData = createSelector(
+  selectAdminPanelData,
+  (data) => data?.usertypeData ?? [],
+);
+
+export const selectAdminPanelHazuData = createSelector(
+  selectAdminPanelData,
+  (data) => data?.hazuData ?? {},
+);
+
+// Filter first level data - only room Hazus (for addGroup type dropdown)
+export const selectAdminPanelRoomTypes = createSelector(
+  selectAdminPanelFirstLevelData,
+  (firstLevel) =>
+    firstLevel.filter(
+      (item) =>
+        item.isHazu && // Only Hazus
+        item.tags?.some((tag) => tag.startsWith("hz-config-room")),
+    ),
+);
+
+// Filter first level data - only profile Hazus (for addUser type dropdown)
+export const selectAdminPanelProfileTypes = createSelector(
+  selectAdminPanelFirstLevelData,
+  (firstLevel) =>
+    firstLevel.filter(
+      (item) =>
+        item.isHazu && // Only Hazus
+        item.tags?.some((tag) => tag.startsWith("hz-config-profile")),
+    ),
+);
+
+// Filter template data by room tags (for addGroup template dropdown)
+export const selectAdminPanelRoomTemplates = createSelector(
+  selectAdminPanelTemplateData,
+  (templates) =>
+    templates.filter(
+      (t) => t.tags?.some((tag) => tag.startsWith("hz-config-room")),
+    ),
+);
+
+// Filter template data by profile tags (for addUser template dropdown)
+export const selectAdminPanelProfileTemplates = createSelector(
+  selectAdminPanelTemplateData,
+  (templates) =>
+    templates.filter(
+      (t) => t.tags?.some((tag) => tag.startsWith("hz-config-profile")),
+    ),
+);
+
+// Tag Management Selectors
+export const selectAdminPanelExpandedTreeNodes = createSelector(
+  selectAdminPanelState,
+  (state) => state.expandedTreeNodes,
+);
+
+export const selectAdminPanelSelectedUpdateMode = createSelector(
+  selectAdminPanelState,
+  (state) => state.selectedUpdateMode,
+);
+
+export const selectAdminPanelTemplateChildrenData = createSelector(
+  selectAdminPanelData,
+  (data) => data?.templateChildrenData ?? {},
+);
+
+export const selectAdminPanelUpdatingRoles = createSelector(
+  selectAdminPanelState,
+  (state) => state.updatingRoles,
+);
