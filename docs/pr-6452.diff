+<div class="group-management-tab">
+  <h3>{{ "ADMIN_PANEL.GROUP_MANAGEMENT.TITLE" | translate }}</h3>
+  <p class="subtitle">
+    {{ "ADMIN_PANEL.GROUP_MANAGEMENT.SUBTITLE" | translate }}
+  </p>
+
+  <!-- Search and Filter -->
+  <div class="controls">
+    <div class="ui input">
+      <input
+        type="text"
+        [placeholder]="
+          'ADMIN_PANEL.GROUP_MANAGEMENT.SEARCH_PLACEHOLDER' | translate
+        "
+        [value]="searchTerm"
+        (input)="onSearchChange($any($event.target).value)"
+      />
+    </div>
+    <div class="ui buttons">
+      <button
+        class="ui button"
+        [class.active]="filterType === 'all'"
+        (click)="setFilterType('all')"
+      >
+        {{ "ALL" | translate }}
+      </button>
+      <button
+        class="ui button"
+        [class.active]="filterType === 'users'"
+        (click)="setFilterType('users')"
+      >
+        {{ "ADMIN_PANEL.GROUP_MANAGEMENT.FILTER_USERS" | translate }}
+      </button>
+      <button
+        class="ui button"
+        [class.active]="filterType === 'groups'"
+        (click)="setFilterType('groups')"
+      >
+        {{ "ADMIN_PANEL.GROUP_MANAGEMENT.FILTER_GROUPS" | translate }}
+      </button>
+    </div>
+  </div>
+
+  <!-- Management Table -->
+  <div class="table-container">
+    <table class="ui celled table">
+      <thead>
+        <tr>
+          <th>{{ "NAME" | translate }}</th>
+          <th>{{ "TYPE" | translate }}</th>
+          <th *ngFor="let class of getClasses()">
+            {{ class.titleText }}
+            <i
+              class="cog icon link"
+              (click)="filterType === 'groups' ? renameGroup(class.key) : null"
+              *ngIf="filterType === 'groups'"
+            ></i>
+          </th>
+          <th>{{ "ACTIONS" | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of getTableRows()">
+          <td>{{ row.item.titleText }}</td>
+          <td>
+            <span
+              class="ui label"
+              [class.blue]="row.type === 'user'"
+              [class.green]="row.type === 'group'"
+            >
+              {{ row.type === "user" ? "User" : "Group" }}
+            </span>
+          </td>
+          <td *ngFor="let class of getClasses()">
+            <div
+              *ngIf="row.type === 'user' && hasClassMembership(row, class.key)"
+            >
+              <select
+                class="ui compact dropdown"
+                [value]="getUserTypeForClass(row, class.key)"
+                (change)="
+                  updateUserType(row.id, class.key, $any($event.target).value)
+                "
+              >
+                <option value="">-</option>
+                <option
+                  *ngFor="let usertype of usertypeData()"
+                  [value]="usertype.titleText"
+                >
+                  {{ usertype.titleText }}
+                </option>
+              </select>
+            </div>
+            <div *ngIf="row.type === 'group' && row.id === class.key">
+              <i class="check icon green"></i>
+            </div>
+          </td>
+          <td>
+            <div class="ui buttons">
+              <button
+                class="ui icon button"
+                *ngIf="row.type === 'user'"
+                (click)="deleteUser(row.id, row.item.parentId)"
+                title="Delete User"
+              >
+                <i class="trash icon"></i>
+              </button>
+              <button
+                class="ui icon button"
+                *ngIf="row.type === 'group'"
+                (click)="renameGroup(row.id)"
+                title="Rename Group"
+              >
+                <i class="edit icon"></i>
+              </button>
+              <button
+                class="ui icon button"
+                *ngIf="row.type === 'group'"
+                (click)="deleteGroup(row.id, row.item.parentId)"
+                title="Delete Group"
+              >
+                <i class="trash icon"></i>
+              </button>
+            </div>
+          </td>
+        </tr>
+        <tr *ngIf="getTableRows().length === 0">
+          <td [attr.colspan]="getClasses().length + 3" class="center aligned">
+            {{ "NO_RESULTS" | translate }}
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</div>
