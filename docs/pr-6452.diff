+  /**
+   * Get the usertype identifier from a usertype Item (public for template)
+   */
+  getUsertypeIdentifier(usertype: Item): string | null {
+    // Check for hz-config-usertypes-X tag (plural - the container tag)
+    const pluralTag = usertype.tags?.find((t) =>
+      t.startsWith("hz-config-usertypes-"),
+    );
+    if (pluralTag) {
+      return pluralTag.replace("hz-config-usertypes-", "");
+    }
+
+    // Check for hz-config-usertype-X tag (singular)
+    const singularTag = usertype.tags?.find((t) =>
+      t.startsWith("hz-config-usertype-"),
+    );
+    if (singularTag) {
+      return singularTag.replace("hz-config-usertype-", "");
+    }
+
+    // If first tag doesn't have a config prefix, use it directly
+    const firstTag = usertype.tags?.[0];
+    if (firstTag && !firstTag.startsWith("hz-config-")) {
+      return firstTag.toLowerCase();
+    }
+
+    // Last resort: use the title
+    return usertype.titleText?.toLowerCase() || null;
+  }
+
+  /**
+   * Get the role for a specific usertype on an item
+   */
+  getRoleForUsertype(item: Item, usertype: Item): ShareRole | null {
+    const usertypeTag = this.getUsertypeIdentifier(usertype);
+
+    if (!usertypeTag) {
+      return null;
+    }
+
+    const searchPattern = `hz-share-${usertypeTag}-`;
+    const shareTag = item.tags?.find((tag) => tag.startsWith(searchPattern));
+
+    if (!shareTag) {
+      return null;
+    }
+
+    return shareTag.split("-").pop() as ShareRole;
+  }
+
+  /**
+   * Check if a category is a profile type
+   */
+  isProfileCategory(configTag: string): boolean {
+    return configTag.startsWith("hz-config-profile");
+  }
+
+  /**
+   * Get the self-invite role for an item
+   */
+  getSelfInviteRole(item: Item): ShareRole | null {
+    const selfInviteTag = item.tags?.find((tag) =>
+      tag.startsWith("hz-invite-self-"),
+    );
+
+    if (!selfInviteTag) {
+      return null;
+    }
+
+    return selfInviteTag.split("-").pop() as ShareRole;
+  }
+
+  /**
+   * Get display name for usertype column header
+   */
+  getUsertypeDisplayName(usertype: Item): string {
+    const description = usertype.description;
+    if (description && description.trim() && description !== "<p></p>") {
+      // Apply language filtering to description (subtitle)
+      const filteredDescription =
+        this.filterLanguagesPipe.transform(description);
+      const stripped = filteredDescription.replace(/<[^>]*>/g, "").trim();
+      if (stripped) {
+        return stripped;
+      }
+    }
+    // Apply language filtering to title
+    const filteredTitle = this.filterLanguagesPipe.transform(usertype.title);
+    const title = filteredTitle.replace(/<[^>]*>/g, "").trim() || "";
+    return title.charAt(0).toUpperCase() + title.slice(1);
+  }
+
