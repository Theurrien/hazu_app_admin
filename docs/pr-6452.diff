+import { HttpClient } from "@angular/common/http";
+import {
+  ChangeDetectionStrategy,
+  Component,
+  computed,
+  ElementRef,
+  HostListener,
+  inject,
+  Input,
+  signal,
+  Signal,
+} from "@angular/core";
+import { FilterLanguagesPipe } from "@hazu/shared/pipes/filter-languages.pipe";
+import { Store } from "@ngrx/store";
+import { TranslateService } from "@ngx-translate/core";
+import { Item } from "@shared/model/Item";
+import { environment } from "../../../../../environments/environment";
+import * as AdminPanelActions from "../../state/admin-panel.actions";
+import {
+  selectAdminPanelExpandedTreeNodes,
+  selectAdminPanelFirstLevelData,
+  selectAdminPanelSelectedUpdateMode,
+  selectAdminPanelTemplateChildrenData,
+  selectAdminPanelTemplateData,
+  selectAdminPanelUpdatingRoles,
+  selectAdminPanelUsertypeData,
+} from "../../state/admin-panel.selectors";
+import {
+  AdminPanelData,
+  ShareRole,
+  TypeCategory,
+  UpdateMode,
+} from "../../state/admin-panel.state";
+
+interface RoleOption {
+  value: ShareRole;
+  label: string;
+  icon: string; // FontAwesome icon class
+  color: string; // Icon color
+}
+
+interface ModeOption {
+  value: UpdateMode;
+  label: string;
+}
+
+interface PendingChange {
+  groupId: string; // ID of the first-level group (category) the template is in
+  templateId: string; // ID of the template from templates folder
+  itemId: string; // ID of the Hazu being updated (same as templateId for level 2, different for level 3)
+  usertype: string; // 'self' for self-invite, or the usertype identifier
+  oldRole: ShareRole | null;
+  newRole: ShareRole;
+}
+
+@Component({
+  selector: "hz-tag-management-tab",
+  templateUrl: "./tag-management-tab.component.html",
+  styleUrls: ["./tag-management-tab.component.scss"],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class TagManagementTabComponent {
+  @Input() adminData!: AdminPanelData;
+
+  private elementRef = inject(ElementRef);
+
+  /**
+   * Close dropdowns when clicking outside
+   */
+  @HostListener("document:click", ["$event"])
+  onDocumentClick(event: MouseEvent): void {
+    const target = event.target as HTMLElement;
+    if (!target.closest(".role-dropdown")) {
+      this.closeAllDropdowns();
+    }
+  }
+
+  /**
+   * Global arrow key handler - focuses first dropdown when nothing is focused
+   */
+  @HostListener("document:keydown", ["$event"])
+  onGlobalKeydown(event: KeyboardEvent): void {
+    // Only handle arrow keys
+    if (
+      !["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(event.key)
+    ) {
+      return;
+    }
+
+    const container = this.elementRef.nativeElement as HTMLElement;
+    const activeElement = document.activeElement;
+
+    // Check if we're already focused on a dropdown inside this component
+    if (
+      activeElement &&
+      container.contains(activeElement) &&
+      activeElement.classList.contains("role-dropdown")
+    ) {
+      return; // Let the dropdown's keydown handler deal with it
+    }
+
+    // Check if the admin panel tab is active (visible)
+    const tabPanel = container.closest(".tab-panel");
+    if (tabPanel && !tabPanel.classList.contains("active")) {
+      return; // Not the active tab, don't interfere
+    }
+
+    // Focus the first dropdown in this component
+    const firstDropdown = container.querySelector(
+      ".role-dropdown",
+    ) as HTMLElement;
+    if (firstDropdown) {
+      event.preventDefault();
+      firstDropdown.focus();
+    }
+  }
+
+  expandedNodes: Signal<string[]>;
+  selectedMode: Signal<UpdateMode>;
+  usertypeData: Signal<Item[]>;
+  firstLevelData: Signal<Item[]>;
+  templateData: Signal<Item[]>;
+  templateChildrenData: Signal<Record<string, Item[]>>;
+  updatingRoles: Signal<string[]>;
+
+  // Computed tree data
+  treeData: Signal<TypeCategory[]>;
+
+  // Display mode toggle: emojis or names (as signal for reactivity)
+  showNamesInsteadOfEmojis = signal(false);
+
+  // Pending changes tracking
+  pendingChanges = signal<PendingChange[]>([]);
+
+  // Computed pending changes count
+  pendingChangesCount = computed(() => this.pendingChanges().length);
+
+  // Loading state for webhook request
+  isSubmitting = signal(false);
+
+  // Toast notification state
+  toastMessage = signal<{ type: "success" | "error"; message: string } | null>(
+    null,
+  );
+
+  // Computed role options that react to display mode changes
+  roleOptions: Signal<RoleOption[]>;
+
+  // Base role options for dropdown (exposed for template)
+  // Using FontAwesome icons with distinct colors for each role
+  roleOptionsBase: RoleOption[] = [
+    {
+      value: "owner",
+      label: "ADMIN_PANEL.TAG_MANAGEMENT.ROLE_OWNER",
+      icon: "fa-user-tie",
+      color: "#9b59b6", // Purple - highest privilege
+    },
+    {
+      value: "admin",
+      label: "ADMIN_PANEL.TAG_MANAGEMENT.ROLE_ADMIN",
+      icon: "fa-user-cog",
+      color: "#e67e22", // Orange
+    },
+    {
+      value: "editor",
+      label: "ADMIN_PANEL.TAG_MANAGEMENT.ROLE_EDITOR",
+      icon: "fa-user-edit",
+      color: "#3498db", // Blue
+    },
+    {
+      value: "reader",
+      label: "ADMIN_PANEL.TAG_MANAGEMENT.ROLE_READER",
+      icon: "fa-user",
+      color: "#27ae60", // Green - basic access
+    },
+    {
+      value: "none",
+      label: "ADMIN_PANEL.TAG_MANAGEMENT.ROLE_NONE",
+      icon: "fa-user-slash",
+      color: "#95a5a6", // Gray - no access
+    },
+  ];
+
+  // Mode options for dropdown (translation keys)
+  private modeOptionKeys: ModeOption[] = [
+    {
+      value: "template",
+      label: "ADMIN_PANEL.TAG_MANAGEMENT.MODE_TEMPLATE_ONLY",
+    },
+    {
