@@ -0,0 +1,480 @@
+<div class="tag-management-container">
+  <!-- Toast notification -->
+  @if (toastMessage(); as toast) {
+    <div
+      class="toast-notification"
+      [class.success]="toast.type === 'success'"
+      [class.error]="toast.type === 'error'"
+      (click)="dismissToast()"
+    >
+      <i
+        class="fas"
+        [class.fa-check-circle]="toast.type === 'success'"
+        [class.fa-exclamation-circle]="toast.type === 'error'"
+      ></i>
+      <span>{{ toast.message }}</span>
+      <i class="fas fa-times close-icon"></i>
+    </div>
+  }
+
+  <!-- Tree Table -->
+  <div class="table-container" (click)="closeAllDropdowns()">
+    <!-- Loading overlay -->
+    @if (isSubmitting()) {
+      <div class="loading-overlay">
+        <div class="ui active inverted dimmer">
+          <div class="ui text loader">
+            {{ "COMMON.LOADING" | translate }}...
+          </div>
+        </div>
+      </div>
+    }
+    <table class="ui celled structured table tree-table">
+      <thead>
+        <tr>
+          <th class="name-column">
+            {{ "ADMIN_PANEL.TAG_MANAGEMENT.NAME" | translate }}
+          </th>
+          <th class="role-column self-column">
+            {{ "ADMIN_PANEL.TAG_MANAGEMENT.SELF_INVITE" | translate }}
+          </th>
+          @for (usertype of usertypeData(); track usertype.key) {
+            <th class="role-column">{{ getUsertypeDisplayName(usertype) }}</th>
+          }
+        </tr>
+      </thead>
+      <tbody>
+        @for (category of treeData(); track category.item.key) {
+          <!-- Level 1: Type Category -->
+          <tr
+            class="level-1"
+            tabindex="0"
+            (click)="toggleNode(category.item.key)"
+            (keydown.enter)="toggleNode(category.item.key)"
+            (keydown.space)="
+              toggleNode(category.item.key); $event.preventDefault()
+            "
+          >
+            <td [attr.colspan]="getColspan()" class="category-row">
+              <i
+                class="fas chevron-icon"
+                [class.fa-chevron-down]="isExpanded(category.item.key)"
+                [class.fa-chevron-right]="!isExpanded(category.item.key)"
+              ></i>
+              <span
+                class="category-title"
+                [style.color]="getCategoryColor(category.item)"
+              >
+                {{ category.item.title | filterLanguages | htmlToPlaintext }}
+              </span>
+            </td>
+          </tr>
+
+          @if (isExpanded(category.item.key)) {
+            @for (
+              templateData of category.templates;
+              track templateData.template.key
+            ) {
+              <!-- Level 2: Template -->
+              <tr
+                class="level-2"
+                tabindex="0"
+                (click)="toggleNode(templateData.template.key, $event)"
+                (keydown.enter)="toggleNode(templateData.template.key)"
+                (keydown.space)="
+                  toggleNode(templateData.template.key); $event.preventDefault()
+                "
+              >
+                <td class="template-row">
+                  <i
+                    class="fas chevron-icon"
+                    [class.fa-chevron-down]="
+                      isExpanded(templateData.template.key)
+                    "
+                    [class.fa-chevron-right]="
+                      !isExpanded(templateData.template.key)
+                    "
+                  ></i>
+                  <span class="template-name">{{
+                    templateData.template.title
+                      | filterLanguages
+                      | htmlToPlaintext
+                  }}</span>
+                </td>
+                <!-- Self-invite column (only for profile categories) -->
+                <td
+                  class="role-cell"
+                  (click)="closeAllDropdowns(); $event.stopPropagation()"
+                >
+                  @if (isProfileCategory(category.configTag)) {
+                    <div
+                      class="role-dropdown-wrapper"
+                      [class.has-pending-change]="
+                        hasPendingChange(templateData.template.key, 'self')
+                      "
+                    >
+                      <div
+                        class="ui dropdown role-dropdown"
+                        #selfDropdown2
+                        tabindex="0"
+                        (click)="openDropdown($event)"
+                        (keydown)="onDropdownKeydown($event, selfDropdown2)"
+                      >
+                        <i
+                          class="fas role-icon"
+                          [ngClass]="
+                            getRoleIcon(
+                              getPendingOrCurrentSelfRole(templateData.template)
+                            )
+                          "
+                          [style.color]="
+                            getRoleColor(
+                              getPendingOrCurrentSelfRole(templateData.template)
+                            )
+                          "
+                          [title]="
+                            getRoleName(
+                              getPendingOrCurrentSelfRole(templateData.template)
+                            )
+                          "
+                        ></i>
+                        <span
+                          class="role-text"
+                          [class.visible]="showNamesInsteadOfEmojis()"
+                          >{{
+                            getRoleName(
+                              getPendingOrCurrentSelfRole(templateData.template)
+                            )
+                          }}</span
+                        >
+                        <div class="menu">
+                          @for (option of roleOptionsBase; track option.value) {
+                            <div
+                              class="item"
+                              [class.active]="
+                                (getPendingOrCurrentSelfRole(
+                                  templateData.template
+                                ) || 'none') === option.value
+                              "
+                              (click)="
+                                onSelfInviteRoleSelect(
+                                  templateData.template,
+                                  option.value,
+                                  category.item.key
+                                )
+                              "
+                            >
+                              <i
+                                class="fas role-icon"
+                                [ngClass]="option.icon"
+                                [style.color]="option.color"
+                              ></i>
+                              <span class="role-label">{{
+                                translateService.instant(option.label)
+                              }}</span>
+                            </div>
+                          }
+                        </div>
+                      </div>
+                    </div>
+                  } @else {
+                    <span class="not-applicable">—</span>
+                  }
+                </td>
+                @for (usertype of usertypeData(); track usertype.key) {
+                  <td
+                    class="role-cell"
+                    (click)="closeAllDropdowns(); $event.stopPropagation()"
+                  >
+                    <div
+                      class="role-dropdown-wrapper"
+                      [class.has-pending-change]="
+                        hasPendingChange(
+                          templateData.template.key,
+                          getUsertypeIdentifier(usertype) || ''
+                        )
+                      "
+                    >
+                      <div
+                        class="ui dropdown role-dropdown"
+                        #roleDropdown2
+                        tabindex="0"
+                        (click)="openDropdown($event)"
+                        (keydown)="onDropdownKeydown($event, roleDropdown2)"
+                      >
+                        <i
+                          class="fas role-icon"
+                          [ngClass]="
+                            getRoleIcon(
+                              getPendingOrCurrentRole(
+                                templateData.template,
+                                usertype
+                              )
+                            )
+                          "
+                          [style.color]="
+                            getRoleColor(
+                              getPendingOrCurrentRole(
+                                templateData.template,
+                                usertype
+                              )
+                            )
+                          "
+                          [title]="
+                            getRoleName(
+                              getPendingOrCurrentRole(
+                                templateData.template,
+                                usertype
+                              )
+                            )
+                          "
+                        ></i>
+                        <span
+                          class="role-text"
+                          [class.visible]="showNamesInsteadOfEmojis()"
+                          >{{
+                            getRoleName(
+                              getPendingOrCurrentRole(
+                                templateData.template,
+                                usertype
+                              )
+                            )
+                          }}</span
+                        >
+                        <div class="menu">
+                          @for (option of roleOptionsBase; track option.value) {
+                            <div
+                              class="item"
+                              [class.active]="
+                                (getPendingOrCurrentRole(
+                                  templateData.template,
+                                  usertype
+                                ) || 'none') === option.value
+                              "
+                              (click)="
+                                onRoleSelect(
+                                  templateData.template,
+                                  usertype,
+                                  option.value,
+                                  category.item.key
+                                )
+                              "
+                            >
+                              <i
+                                class="fas role-icon"
+                                [ngClass]="option.icon"
+                                [style.color]="option.color"
+                              ></i>
+                              <span class="role-label">{{
+                                translateService.instant(option.label)
+                              }}</span>
+                            </div>
+                          }
+                        </div>
+                      </div>
+                    </div>
+                  </td>
+                }
+              </tr>
+
+              @if (isExpanded(templateData.template.key)) {
+                @for (child of templateData.children; track child.key) {
+                  <!-- Level 3: Template Children -->
+                  <tr class="level-3">
+                    <td class="child-row" (click)="closeAllDropdowns()">
+                      <span class="child-name">{{
+                        child.title | filterLanguages | htmlToPlaintext
+                      }}</span>
+                    </td>
+                    <!-- Self-invite column (only for profile categories) -->
+                    <td class="role-cell" (click)="closeAllDropdowns()">
+                      @if (isProfileCategory(category.configTag)) {
+                        <div
+                          class="role-dropdown-wrapper"
+                          [class.has-pending-change]="
+                            hasPendingChange(child.key, 'self')
+                          "
+                        >
+                          <div
+                            class="ui dropdown role-dropdown"
+                            #selfDropdown3
+                            tabindex="0"
+                            (click)="openDropdown($event)"
+                            (keydown)="onDropdownKeydown($event, selfDropdown3)"
+                          >
+                            <i
+                              class="fas role-icon"
+                              [ngClass]="
+                                getRoleIcon(getPendingOrCurrentSelfRole(child))
+                              "
+                              [style.color]="
+                                getRoleColor(getPendingOrCurrentSelfRole(child))
+                              "
+                              [title]="
+                                getRoleName(getPendingOrCurrentSelfRole(child))
+                              "
+                            ></i>
+                            <span
+                              class="role-text"
+                              [class.visible]="showNamesInsteadOfEmojis()"
+                              >{{
+                                getRoleName(getPendingOrCurrentSelfRole(child))
+                              }}</span
+                            >
+                            <div class="menu">
+                              @for (
+                                option of roleOptionsBase;
+                                track option.value
+                              ) {
+                                <div
+                                  class="item"
+                                  [class.active]="
+                                    (getPendingOrCurrentSelfRole(child) ||
+                                      'none') === option.value
+                                  "
+                                  (click)="
+                                    onSelfInviteRoleSelect(
+                                      child,
+                                      option.value,
+                                      category.item.key,
+                                      templateData.template.key
+                                    )
+                                  "
+                                >
+                                  <i
+                                    class="fas role-icon"
+                                    [ngClass]="option.icon"
+                                    [style.color]="option.color"
+                                  ></i>
+                                  <span class="role-label">{{
+                                    translateService.instant(option.label)
+                                  }}</span>
+                                </div>
+                              }
+                            </div>
+                          </div>
+                        </div>
+                      } @else {
+                        <span class="not-applicable">—</span>
+                      }
+                    </td>
+                    @for (usertype of usertypeData(); track usertype.key) {
+                      <td class="role-cell" (click)="closeAllDropdowns()">
+                        <div
+                          class="role-dropdown-wrapper"
+                          [class.has-pending-change]="
+                            hasPendingChange(
+                              child.key,
+                              getUsertypeIdentifier(usertype) || ''
+                            )
+                          "
+                        >
+                          <div
+                            class="ui dropdown role-dropdown"
+                            #roleDropdown3
+                            tabindex="0"
+                            (click)="openDropdown($event)"
+                            (keydown)="onDropdownKeydown($event, roleDropdown3)"
+                          >
+                            <i
+                              class="fas role-icon"
+                              [ngClass]="
+                                getRoleIcon(
+                                  getPendingOrCurrentRole(child, usertype)
+                                )
+                              "
+                              [style.color]="
+                                getRoleColor(
+                                  getPendingOrCurrentRole(child, usertype)
+                                )
+                              "
+                              [title]="
+                                getRoleName(
+                                  getPendingOrCurrentRole(child, usertype)
+                                )
+                              "
+                            ></i>
+                            <span
+                              class="role-text"
+                              [class.visible]="showNamesInsteadOfEmojis()"
+                              >{{
+                                getRoleName(
+                                  getPendingOrCurrentRole(child, usertype)
+                                )
+                              }}</span
+                            >
+                            <div class="menu">
+                              @for (
+                                option of roleOptionsBase;
+                                track option.value
+                              ) {
+                                <div
+                                  class="item"
+                                  [class.active]="
+                                    (getPendingOrCurrentRole(child, usertype) ||
+                                      'none') === option.value
+                                  "
+                                  (click)="
+                                    onRoleSelect(
+                                      child,
+                                      usertype,
+                                      option.value,
+                                      category.item.key,
+                                      templateData.template.key
+                                    )
+                                  "
+                                >
+                                  <i
+                                    class="fas role-icon"
+                                    [ngClass]="option.icon"
+                                    [style.color]="option.color"
+                                  ></i>
+                                  <span class="role-label">{{
+                                    translateService.instant(option.label)
+                                  }}</span>
+                                </div>
+                              }
+                            </div>
+                          </div>
+                        </div>
+                      </td>
+                    }
+                  </tr>
+                }
+              }
+            }
+          }
+        }
+
+        @if (treeData().length === 0) {
+          <tr>
+            <td [attr.colspan]="getColspan()" class="no-data">
+              {{ "ADMIN_PANEL.TAG_MANAGEMENT.NO_DATA" | translate }}
+            </td>
+          </tr>
+        }
+      </tbody>
+    </table>
+
+    <!-- Instructions (collapsed by default) - inside scrollable area -->
+    <details class="instruction-details">
+      <summary>
+        <i class="fas fa-info-circle"></i>
+        {{ "ADMIN_PANEL.TAG_MANAGEMENT.INSTRUCTION_TITLE" | translate }}
+      </summary>
+      <p class="instruction-text">
+        This table shows the share group permissions for templates. Each cell
+        shows the role (<i class="fas fa-user-tie" style="color: #9b59b6"></i
+        >&nbsp;Owner,
+        <i class="fas fa-user-cog" style="color: #e67e22"></i>&nbsp;Admin,
+        <i class="fas fa-user-edit" style="color: #3498db"></i>&nbsp;Editor,
+        <i class="fas fa-user" style="color: #27ae60"></i>&nbsp;Reader) that a
+        user type has on the corresponding template. Select a role to update the
+        permissions. The update mode determines whether changes apply to the
+        template only, existing profiles only, or both. The 'Self' column (only
+        for profiles) determines what role users get when they invite
+        themselves.
+      </p>
+    </details>
+  </div>
+</div>
