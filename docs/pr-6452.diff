+              'ADMIN_PANEL.ADD_USER.FIRSTNAME_PLACEHOLDER' | translate
+            "
+            [value]="form().firstName"
+            (input)="updateForm({ firstName: $any($event.target).value })"
+          />
+        </div>
+        <div class="field">
+          <label>{{ "LASTNAME" | translate }}</label>
+          <input
+            type="text"
+            [placeholder]="
+              'ADMIN_PANEL.ADD_USER.LASTNAME_PLACEHOLDER' | translate
+            "
+            [value]="form().lastName"
+            (input)="updateForm({ lastName: $any($event.target).value })"
+          />
+        </div>
+      </div>
+
+      <!-- Email Input -->
+      <div class="field">
+        <label>{{ "EMAIL" | translate }}</label>
+        <input
+          type="email"
+          [placeholder]="'ADMIN_PANEL.ADD_USER.EMAIL_PLACEHOLDER' | translate"
+          [value]="form().email"
+          (input)="updateForm({ email: $any($event.target).value })"
+        />
+      </div>
+
+      <!-- Class Lists -->
+      <div class="field" *ngIf="classLists().length > 0">
+        <label>{{ "CLASSES" | translate }}</label>
+        <div *ngFor="let classList of classLists()" class="class-list-group">
+          <h4>{{ classList.title }}</h4>
+          <div *ngFor="let class of classList.classes" class="class-item">
+            <div class="ui checkbox">
+              <input
+                type="checkbox"
+                [checked]="isClassSelected(class.key)"
+                (change)="toggleClass(class.key)"
+                [id]="'class-' + class.key"
+              />
+              <label [for]="'class-' + class.key">{{ class.titleText }}</label>
+            </div>
+            <div *ngIf="isClassSelected(class.key)" class="usertype-select">
+              <hz-select
+                [value]="getClassUserType(class.key)"
+                (valueChange)="updateClassUserType(class.key, $event)"
+                [options]="usertypeOptions()"
+                labelField="label"
+                valueField="value"
+                [placeholder]="'SELECT_USERTYPE' | translate"
+                [isSearchable]="false"
+              ></hz-select>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <!-- Guardian Emails -->
+      <div class="field">
+        <label>{{ "ADMIN_PANEL.ADD_USER.GUARDIAN_INFO" | translate }}</label>
+        <div class="two fields">
+          <div class="field">
+            <input
+              type="email"
+              [placeholder]="'ADMIN_PANEL.ADD_USER.GUARDIAN_1' | translate"
+              [value]="form().guardian1Email"
+              (input)="
+                updateForm({ guardian1Email: $any($event.target).value })
+              "
+            />
+          </div>
+          <div class="field">
+            <input
+              type="email"
+              [placeholder]="'ADMIN_PANEL.ADD_USER.GUARDIAN_2' | translate"
+              [value]="form().guardian2Email"
+              (input)="
+                updateForm({ guardian2Email: $any($event.target).value })
+              "
+            />
+          </div>
+        </div>
+      </div>
+
+      <!-- Invitation Mail Checkbox -->
+      <div class="field">
+        <div class="ui checkbox">
+          <input
+            type="checkbox"
+            [checked]="form().sendInvitationMail"
+            (change)="
+              updateForm({ sendInvitationMail: $any($event.target).checked })
+            "
+            id="invitation-mail"
+          />
+          <label for="invitation-mail">
+            {{ "ADMIN_PANEL.ADD_USER.INVITATION_MAIL" | translate }}
+            <i
+              class="question circle icon"
+              [attr.data-tooltip]="
+                'ADMIN_PANEL.ADD_USER.INVITATION_MAIL_TOOLTIP' | translate
+              "
+            ></i>
+          </label>
+        </div>
+      </div>
+
+      <!-- Submit Button -->
+      <button
+        class="ui primary button"
+        type="submit"
+        [class.disabled]="
+          !form().type ||
+          !form().template ||
+          !form().firstName ||
+          !form().lastName ||
+          !form().email
+        "
+      >
+        {{ "ADMIN_PANEL.ADD_USER.SUBMIT" | translate }}
+      </button>
+    </div>
+  </form>
+</div>
