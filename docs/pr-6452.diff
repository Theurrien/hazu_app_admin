+   * Dismiss the toast manually
+   */
+  dismissToast(): void {
+    this.toastMessage.set(null);
+  }
+
+  /**
+   * Discard all pending changes
+   */
+  discardChanges(): void {
+    this.pendingChanges.set([]);
