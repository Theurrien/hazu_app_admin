index 0000000000..b1db8ac238
--- /dev/null
+++ b/angular/hazu-app/src/app/features/admin-panel/state/admin-panel.actions.ts
@@ -0,0 +1,180 @@
+import { createAction, props } from "@ngrx/store";
+import { Item } from "@shared/model/Item";
+import {
+  AddGroupForm,
+  AddUserForm,
+  AdminPanelData,
+  ShareRole,
+  UpdateMode,
+} from "./admin-panel.state";
+
+export const openAdminPanel = createAction(
+  "[ADMIN_PANEL] OPEN ADMIN PANEL",
+  props<{ viewMode: "modal" }>(),
+);
+
+export const closeAdminPanel = createAction("[ADMIN_PANEL] CLOSE ADMIN PANEL");
+
+export const setActiveTab = createAction(
+  "[ADMIN_PANEL] SET ACTIVE TAB",
+  props<{
+    tab: "overview" | "add-group" | "add-user" | "group-management";
+  }>(),
+);
+
+export const loadAdminData = createAction(
