+
+  /**
+   * Get translated role name
+   * Shows "None" for both null and "none" roles
+   */
+  getRoleName(role: ShareRole | null): string {
+    // For null or unset roles, show "None"
+    if (!role || role === "none") {
+      const noneOption = this.roleOptionsBase.find((o) => o.value === "none");
+      return noneOption
+        ? this.translateService.instant(noneOption.label)
+        : "None";
