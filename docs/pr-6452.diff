@@ -0,0 +1,99 @@
+import {
+  computed,
+  ChangeDetectionStrategy,
+  Component,
+  Input,
+  Signal,
+} from "@angular/core";
+import { Store } from "@ngrx/store";
+import { Item } from "@shared/model/Item";
+import * as AdminPanelActions from "../../state/admin-panel.actions";
+import {
+  selectAdminPanelAddGroupForm,
+  selectAdminPanelRoomTypes,
+  selectAdminPanelRoomTemplates,
+} from "../../state/admin-panel.selectors";
+import { AddGroupForm } from "../../state/admin-panel.state";
+
+@Component({
+  selector: "hz-add-group-tab",
+  templateUrl: "./add-group-tab.component.html",
+  styleUrls: ["./add-group-tab.component.scss"],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class AddGroupTabComponent {
+  @Input() adminData: any;
+
+  form: Signal<AddGroupForm>;
+  roomTypes: Signal<Item[]>;
+  roomTemplates: Signal<Item[]>;
+  roomTypeOptions: Signal<Array<{ value: string; label: string }>>;
+  templateOptions: Signal<Array<{ value: string; label: string }>>;
+
+  constructor(private store: Store) {
+    this.form = this.store.selectSignal(selectAdminPanelAddGroupForm);
+    this.roomTypes = this.store.selectSignal(selectAdminPanelRoomTypes);
+    this.roomTemplates = this.store.selectSignal(selectAdminPanelRoomTemplates);
+
+    // Compute options reactively - show the Hazu's title, not the extracted tag name
+    this.roomTypeOptions = computed(() => {
+      return this.roomTypes().map((item) => ({
+        value: item.key,
+        label: item.titleText || "Unknown",
+      }));
+    });
+
+    this.templateOptions = computed(() => {
+      const selectedType = this.form().type;
+      if (!selectedType) {
+        return [];
+      }
+
+      // Find the selected type item to get its tag
+      const roomType = this.roomTypes().find((t) => t.key === selectedType);
+      if (!roomType) {
+        return [];
+      }
+
+      const roomTag = roomType.tags?.find((t) =>
+        t.startsWith("hz-config-room-"),
+      );
+      if (!roomTag) {
+        return [];
+      }
+
+      // Filter templates that have the same tag
+      return this.roomTemplates()
+        .filter((template) => template.tags?.includes(roomTag))
+        .map((template) => ({
+          value: template.key,
+          label: template.titleText || "Unknown Template",
+        }));
+    });
+  }
+
+  updateForm(updates: Partial<AddGroupForm>): void {
+    this.store.dispatch(
+      AdminPanelActions.updateAddGroupForm({ formData: updates }),
+    );
+  }
+
+  onSubmit(): void {
+    const formData = this.form();
+    if (!formData.type || !formData.template || !formData.title) {
+      return;
+    }
+
+    this.store.dispatch(AdminPanelActions.submitAddGroup({ formData }));
+  }
+
+  getRoomTypeLabel(item: Item): string {
+    // Extract the type from tags (e.g., "hz-config-room-class" -> "Class")
+    const roomTag = item.tags?.find((t) => t.startsWith("hz-config-room-"));
+    if (roomTag) {
+      const type = roomTag.replace("hz-config-room-", "");
+      return type.charAt(0).toUpperCase() + type.slice(1);
+    }
+    return item.titleText || "Unknown";
+  }
+}
