+import {
+  ChangeDetectionStrategy,
+  Component,
+  Input,
+  OnDestroy,
+  OnInit,
+  Signal,
+  ViewChild,
+} from "@angular/core";
+import { Store } from "@ngrx/store";
+import { Item } from "@shared/model/Item";
+import { Subscription } from "rxjs";
+import { TagManagementTabComponent } from "../components/tag-management-tab/tag-management-tab.component";
+import * as AdminPanelActions from "../state/admin-panel.actions";
+import {
+  selectAdminPanelActiveTab,
+  selectAdminPanelBaseItem,
+  selectAdminPanelData,
+  selectAdminPanelErrors,
+  selectAdminPanelIsLoading,
+  selectAdminPanelViewMode,
+} from "../state/admin-panel.selectors";
+import { AdminPanelData } from "../state/admin-panel.state";
+
+@Component({
+  selector: "hz-admin-panel-view",
+  templateUrl: "./admin-panel-view.component.html",
+  styleUrls: ["./admin-panel-view.component.scss"],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class AdminPanelViewComponent implements OnInit, OnDestroy {
+  @Input() baseItem!: Item;
+  @ViewChild("tagManagementTab") tagManagementTab?: TagManagementTabComponent;
+
+  viewMode: Signal<"modal" | "closed">;
+  activeTab: Signal<"overview" | "add-group" | "add-user" | "group-management">;
+  isLoading: Signal<boolean>;
+  adminData: Signal<AdminPanelData | null>;
+  errors: Signal<string[]>;
+  private dataSubscription?: Subscription;
+  private hasInitialized = false;
+
+  constructor(private store: Store) {
+    this.viewMode = this.store.selectSignal(selectAdminPanelViewMode);
+    this.activeTab = this.store.selectSignal(selectAdminPanelActiveTab);
+    this.isLoading = this.store.selectSignal(selectAdminPanelIsLoading);
+    this.adminData = this.store.selectSignal(selectAdminPanelData);
+    this.errors = this.store.selectSignal(selectAdminPanelErrors);
+  }
+
+  ngOnInit(): void {
+    console.log(
+      "[AdminPanelViewComponent] ngOnInit called with baseItem:",
+      this.baseItem,
+    );
+
+    // Prevent multiple initializations
+    if (this.hasInitialized) {
+      console.log("[AdminPanelViewComponent] Already initialized, skipping");
+      return;
+    }
+
+    if (!this.baseItem) {
+      console.error("[AdminPanelViewComponent] baseItem is null/undefined!");
+      return;
+    }
+
+    // Only dispatch if data not already loaded for this baseItem
+    // The effect will handle preventing concurrent loads with exhaustMap
+    const currentBaseItem = this.store.selectSignal(selectAdminPanelBaseItem)();
+    const currentData = this.adminData();
+
+    console.log("[AdminPanelViewComponent] State check:", {
+      baseItemKey: this.baseItem.key,
+      currentBaseItemKey: currentBaseItem?.key,
+      hasCurrentData: currentData !== null,
+    });
+
+    // If data is already loaded for the same baseItem, skip
+    if (currentBaseItem?.key === this.baseItem.key && currentData !== null) {
+      console.log(
+        "[AdminPanelViewComponent] Data already loaded for this baseItem, skipping dispatch",
+      );
+      this.hasInitialized = true;
+      return;
+    }
+
+    console.log("[AdminPanelViewComponent] Dispatching loadAdminData action");
+    this.hasInitialized = true;
+    this.store.dispatch(
+      AdminPanelActions.loadAdminData({ baseItem: this.baseItem }),
+    );
+
+    // Watch for data changes in real-time
+    this.dataSubscription = this.store
+      .select(selectAdminPanelData)
+      .subscribe((data) => {
+        if (data) {
+          console.log("[AdminPanelViewComponent] Data received:", {
+            firstLevel: data.firstLevelData.length,
+            templates: data.templateData.length,
+            usertypes: data.usertypeData.length,
+            hazuDataKeys: Object.keys(data.hazuData).length,
+          });
+        }
+      });
+  }
+
+  ngOnDestroy(): void {
+    if (this.dataSubscription) {
+      this.dataSubscription.unsubscribe();
+    }
+  }
+
+  onClose(): void {
+    this.store.dispatch(AdminPanelActions.closeAdminPanel());
+  }
+
+  setActiveTab(
+    tab: "overview" | "add-group" | "add-user" | "group-management",
+  ): void {
+    this.store.dispatch(AdminPanelActions.setActiveTab({ tab }));
+  }
+}
