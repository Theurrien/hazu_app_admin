+
+  /**
+   * Apply all pending changes - sends to webhook
+   */
+  applyChanges(): void {
+    const changes = this.pendingChanges();
+    if (changes.length === 0) return;
+
+    // Close any open dropdowns before submitting
+    this.closeAllDropdowns();
+
+    // Build the webhook payload with correct structure
+    const env = environment.HOST?.split(".").pop() ?? "swiss";
+    const webhookPayload = {
+      env,
+      mode: this.selectedMode(),
+      changes: changes.map((c) => ({
+        groupId: c.groupId, // ID of the first-level group (category)
+        templateId: c.templateId, // ID of template from templates folder
+        itemId: c.itemId, // ID of the Hazu being updated
+        usertype: c.usertype,
+        oldRole: c.oldRole,
+        newRole: c.newRole,
+      })),
+    };
+
+    console.log("========================================");
+    console.log("[TagManagement] WEBHOOK PAYLOAD:");
+    console.log(JSON.stringify(webhookPayload, null, 2));
+    console.log("========================================");
+
+    // Start loading state
+    this.isSubmitting.set(true);
+    this.toastMessage.set(null);
+
+    console.log("[TagManagement] Sending to webhook:", this.webhookUrl);
+
+    // Send to webhook
+    this.http.post(this.webhookUrl, webhookPayload).subscribe({
+      next: (response: unknown) => {
+        console.log("[TagManagement] Webhook response:", response);
+
+        // Check if response is empty/null/undefined - treat as error
+        if (
+          response === null ||
+          response === undefined ||
+          response === "" ||
+          (typeof response === "object" &&
+            response !== null &&
+            Object.keys(response).length === 0)
+        ) {
+          console.error(
+            "[TagManagement] Webhook returned empty response - treating as error",
+          );
+          this.isSubmitting.set(false);
+          this.showToast(
+            "error",
+            this.translateService.instant("ADMIN_PANEL.TAG_MANAGEMENT.ERROR"),
+          );
+          return;
+        }
+
+        // Check if response indicates an error (n8n might return 200 with error in body)
+        const resp = response as Record<string, unknown> | null;
+        if (
+          resp &&
+          (resp["error"] ||
+            resp["success"] === false ||
+            resp["status"] === "error")
+        ) {
+          console.error(
+            "[TagManagement] Webhook returned error in response:",
+            resp,
+          );
+          this.isSubmitting.set(false);
+          this.showToast(
+            "error",
+            (resp["message"] as string) ||
+              this.translateService.instant("ADMIN_PANEL.TAG_MANAGEMENT.ERROR"),
+          );
+          return;
+        }
+
+        // Dispatch each change to update local state (for tracking)
+        changes.forEach((change) => {
+          this.store.dispatch(
+            AdminPanelActions.updateShareRole({
+              itemId: change.itemId,
+              usertype: change.usertype,
+              newRole: change.newRole,
+              mode: this.selectedMode(),
+            }),
+          );
+        });
+
+        // Update item tags in store to trigger rerender with new data
+        changes.forEach((change) => {
+          this.store.dispatch(
+            AdminPanelActions.updateItemTags({
+              itemId: change.itemId,
+              usertype: change.usertype,
+              newRole: change.newRole,
+              oldRole: change.oldRole,
+            }),
+          );
+        });
+
+        // Clear pending changes and stop loading
+        this.pendingChanges.set([]);
+        this.isSubmitting.set(false);
+
+        // Show success toast
+        this.showToast(
+          "success",
+          this.translateService.instant(
+            "ADMIN_PANEL.TAG_MANAGEMENT.CHANGES_APPLIED",
+          ),
+        );
+      },
+      error: (error) => {
+        console.error("[TagManagement] Webhook error:", error);
+        this.isSubmitting.set(false);
+
+        // Show error toast
+        this.showToast(
+          "error",
+          this.translateService.instant("ADMIN_PANEL.TAG_MANAGEMENT.ERROR"),
+        );
+      },
+    });
+  }
+
+  /**
+   * Show a toast notification
+   */
+  private showToast(type: "success" | "error", message: string): void {
+    this.toastMessage.set({ type, message });
+
+    // Auto-hide toast after 4 seconds
+    setTimeout(() => {
+      this.toastMessage.set(null);
+    }, 4000);
+  }
+
