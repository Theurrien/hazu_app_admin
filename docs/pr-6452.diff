+++ b/angular/hazu-app/src/app/features/admin-panel/components/group-management-tab/group-management-tab.component.ts
@@ -0,0 +1,203 @@
+import {
+  ChangeDetectionStrategy,
+  Component,
+  Input,
+  Signal,
+} from "@angular/core";
+import { Store } from "@ngrx/store";
+import { Item } from "@shared/model/Item";
+import * as AdminPanelActions from "../../state/admin-panel.actions";
+import {
+  selectAdminPanelData,
+  selectAdminPanelFirstLevelData,
+  selectAdminPanelHazuData,
+  selectAdminPanelUsertypeData,
+} from "../../state/admin-panel.selectors";
+import { AdminPanelData } from "../../state/admin-panel.state";
+
+interface TableRow {
+  id: string;
+  name: string;
+  type: "user" | "group";
+  classes: Record<string, string>; // classId -> userType
+  item: Item;
+}
+
+@Component({
+  selector: "hz-group-management-tab",
+  templateUrl: "./group-management-tab.component.html",
+  styleUrls: ["./group-management-tab.component.scss"],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class GroupManagementTabComponent {
+  @Input() adminData: any;
+
+  data: Signal<AdminPanelData | null>;
+  firstLevelData: Signal<Item[]>;
+  hazuData: Signal<Record<string, Item[]>>;
+  usertypeData: Signal<Item[]>;
+
+  searchTerm = "";
+  filterType: "all" | "users" | "groups" = "all";
+
+  constructor(private store: Store) {
+    this.data = this.store.selectSignal(selectAdminPanelData);
+    this.firstLevelData = this.store.selectSignal(
+      selectAdminPanelFirstLevelData,
+    );
+    this.hazuData = this.store.selectSignal(selectAdminPanelHazuData);
+    this.usertypeData = this.store.selectSignal(selectAdminPanelUsertypeData);
+  }
+
+  getClasses(): Item[] {
+    const hazuDataObj = this.hazuData();
+    const classes: Item[] = [];
+
+    // Get all room items from first level data
+    const roomItems = this.firstLevelData().filter(
+      (item) => item.tags?.some((t) => t.startsWith("hz-config-room-")),
+    );
+
+    roomItems.forEach((roomItem) => {
+      const roomClasses = hazuDataObj[roomItem.key] || [];
+      classes.push(
+        ...roomClasses.filter(
+          (c) => c.tags?.some((t) => t.startsWith("hz-config-class-")),
+        ),
+      );
+    });
+
+    return classes;
+  }
+
+  getTableRows(): TableRow[] {
+    const hazuDataObj = this.hazuData();
+    const rows: TableRow[] = [];
+
+    // Get profile items (users)
+    const profileItems = this.firstLevelData().filter(
+      (item) => item.tags?.some((t) => t.startsWith("hz-config-profile-")),
+    );
+
+    profileItems.forEach((profileItem) => {
+      const users = hazuDataObj[profileItem.key] || [];
+      users.forEach((user) => {
+        // Extract class memberships from tags
+        const classes: Record<string, string> = {};
+        user.tags?.forEach((tag) => {
+          // Tags like: hz-config-class-{classId}-{usertype}
+          const match = tag.match(/^hz-config-class-([^-]+)-(.+)$/);
+          if (match) {
+            classes[match[1]] = match[2];
+          }
+        });
+
+        rows.push({
+          id: user.key,
+          name: user.titleText || "Unnamed User",
+          type: "user",
+          classes,
+          item: user,
+        });
+      });
+    });
+
+    // Get room items (groups/classes)
+    const roomItems = this.firstLevelData().filter(
+      (item) => item.tags?.some((t) => t.startsWith("hz-config-room-")),
+    );
+
+    roomItems.forEach((roomItem) => {
+      const groups = hazuDataObj[roomItem.key] || [];
+      groups.forEach((group) => {
+        rows.push({
+          id: group.key,
+          name: group.titleText || "Unnamed Group",
+          type: "group",
+          classes: { [group.key]: "group" }, // Mark as group entry
+          item: group,
+        });
+      });
+    });
+
+    return this.filterRows(rows);
+  }
+
+  filterRows(rows: TableRow[]): TableRow[] {
+    let filtered = rows;
+
+    // Filter by type
+    if (this.filterType === "users") {
+      filtered = filtered.filter((r) => r.type === "user");
+    } else if (this.filterType === "groups") {
+      filtered = filtered.filter((r) => r.type === "group");
+    }
+
+    // Filter by search term
+    if (this.searchTerm) {
+      const term = this.searchTerm.toLowerCase();
+      filtered = filtered.filter((r) => r.name.toLowerCase().includes(term));
+    }
+
+    return filtered;
+  }
+
+  onSearchChange(value: string): void {
+    this.searchTerm = value;
+  }
+
+  setFilterType(type: "all" | "users" | "groups"): void {
+    this.filterType = type;
+  }
+
+  updateUserType(userId: string, classId: string, userType: string): void {
+    if (
+      confirm(
+        "Do you really want to update the usertype? This will change the user's role in this class.",
+      )
+    ) {
+      this.store.dispatch(
+        AdminPanelActions.updateUserRole({ userId, classId, role: userType }),
+      );
+    }
+  }
+
+  deleteUser(userId: string, templateId: string): void {
+    if (
+      confirm(
+        "Do you really want to delete this user profile? This action cannot be undone.",
+      )
+    ) {
+      this.store.dispatch(AdminPanelActions.deleteUser({ userId, templateId }));
+    }
+  }
+
+  deleteGroup(groupId: string, templateId: string): void {
+    if (
+      confirm(
+        "Do you really want to delete this class? This action cannot be undone.",
+      )
+    ) {
+      this.store.dispatch(
+        AdminPanelActions.deleteGroup({ groupId, templateId }),
+      );
+    }
+  }
+
+  renameGroup(groupId: string): void {
+    const newName = prompt("Enter new name for this group:");
+    if (newName && newName.trim()) {
+      this.store.dispatch(
+        AdminPanelActions.renameGroup({ groupId, name: newName.trim() }),
+      );
+    }
+  }
+
+  getUserTypeForClass(row: TableRow, classId: string): string {
+    return row.classes[classId] || "";
+  }
+
+  hasClassMembership(row: TableRow, classId: string): boolean {
+    return !!row.classes[classId];
+  }
+}
diff --git a/angular/hazu-app/src/app/features/admin-panel/components/tag-management-tab/tag-management-tab.component.html b/angular/hazu-app/src/app/features/admin-panel/components/tag-management-tab/tag-management-tab.component.html
