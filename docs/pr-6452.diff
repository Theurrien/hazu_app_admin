+  // Make modal fill 90vh with 5vh top spacing like skills modal
+  &.top.aligned.fullscreen .ui.modal {
+    max-height: 90vh !important;
+    height: 90vh !important;
+    margin: 0 !important; // Remove any default margins
+    top: 5vh !important; // Add space above modal like skills modal
+    display: flex !important;
+    flex-direction: column !important;
+  }
+
+  // Header should not shrink - match skills modal header padding exactly
+  &.top.aligned.fullscreen .ui.modal > .header {
+    flex-shrink: 0 !important;
+    padding: 0.5rem 1.5rem !important; // Match skills modal header padding
+  }
+
+  // Content area - matches skills modal scrolling behavior exactly
+  &.top.aligned.fullscreen .ui.modal > .scrolling.content {
+    flex: 1 1 auto !important;
+    min-height: 0 !important;
+    max-height: none !important;
+    overflow: hidden auto !important;
+    // Keep default padding for proper spacing (like skills modal)
+    padding-top: 1.5rem; // Add top padding like skills modal
+  }
