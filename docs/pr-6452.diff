+import { createReducer, on } from "@ngrx/store";
+import { Item } from "@shared/model/Item";
+import * as AdminPanelActions from "./admin-panel.actions";
+import { adminPanelInitialState } from "./admin-panel.state";
+
+export const adminPanelReducer = createReducer(
+  adminPanelInitialState,
+
+  // View Mode
+  on(AdminPanelActions.openAdminPanel, (state, { viewMode }) => ({
+    ...state,
+    viewMode,
+  })),
+
+  on(AdminPanelActions.closeAdminPanel, (state) => ({
+    ...state,
+    viewMode: "closed" as const,
+  })),
+
+  // Active Tab
+  on(AdminPanelActions.setActiveTab, (state, { tab }) => ({
+    ...state,
+    activeTab: tab,
+  })),
+
+  // Data Loading
+  on(AdminPanelActions.loadAdminData, (state, { baseItem }) => {
+    console.log(
+      "[AdminPanelReducer] loadAdminData action processed, baseItem:",
+      baseItem,
+    );
+    return {
+      ...state,
+      isLoading: true,
+      errors: [],
+      baseItem,
+    };
+  }),
+
+  on(AdminPanelActions.adminDataLoaded, (state, { data }) => {
+    console.log("[AdminPanelReducer] adminDataLoaded action processed, data:", {
+      firstLevelCount: data.firstLevelData.length,
+      templateCount: data.templateData.length,
+      usertypeCount: data.usertypeData.length,
+      hazuDataKeys: Object.keys(data.hazuData).length,
+      firstLevelKeys: data.firstLevelData.map((i) => i.key),
+    });
+
+    // Check for duplicates in the incoming data
+    const firstLevelKeys = new Set<string>();
+    const duplicates: string[] = [];
+    data.firstLevelData.forEach((item) => {
+      if (firstLevelKeys.has(item.key)) {
+        duplicates.push(item.key);
+      } else {
+        firstLevelKeys.add(item.key);
+      }
+    });
+
+    if (duplicates.length > 0) {
+      console.error(
+        "[AdminPanelReducer] DUPLICATES IN INCOMING DATA:",
+        duplicates,
+      );
+    }
+
+    return {
+      ...state,
+      isLoading: false,
+      data,
+      isInitialized: true,
+    };
+  }),
+
+  on(AdminPanelActions.adminDataLoadFailed, (state, { error }) => {
+    console.error(
+      "[AdminPanelReducer] adminDataLoadFailed action processed, error:",
+      error,
+    );
+    return {
+      ...state,
+      isLoading: false,
+      errors: [...state.errors, error],
+    };
+  }),
+
+  // Form Updates
+  on(AdminPanelActions.updateAddGroupForm, (state, { formData }) => ({
+    ...state,
+    forms: {
+      ...state.forms,
+      addGroup: {
+        ...state.forms.addGroup,
+        ...formData,
+      },
+    },
+  })),
+
+  on(AdminPanelActions.updateAddUserForm, (state, { formData }) => ({
+    ...state,
+    forms: {
+      ...state.forms,
+      addUser: {
+        ...state.forms.addUser,
+        ...formData,
+      },
+    },
+  })),
+
+  // Add Group
+  on(AdminPanelActions.submitAddGroup, (state) => ({
+    ...state,
+    isLoading: true,
+    errors: [],
+  })),
+
+  on(AdminPanelActions.addGroupSuccess, (state) => ({
+    ...state,
+    isLoading: false,
+    forms: {
+      ...state.forms,
+      addGroup: adminPanelInitialState.forms.addGroup,
+    },
+  })),
+
+  on(AdminPanelActions.addGroupFailed, (state, { error }) => ({
+    ...state,
+    isLoading: false,
+    errors: [...state.errors, error],
+  })),
+
+  // Add User
+  on(AdminPanelActions.submitAddUser, (state) => ({
+    ...state,
+    isLoading: true,
+    errors: [],
+  })),
+
+  on(AdminPanelActions.addUserSuccess, (state) => ({
+    ...state,
+    isLoading: false,
+    forms: {
+      ...state.forms,
+      addUser: adminPanelInitialState.forms.addUser,
+    },
+  })),
+
+  on(AdminPanelActions.addUserFailed, (state, { error }) => ({
+    ...state,
+    isLoading: false,
+    errors: [...state.errors, error],
+  })),
+
+  // Update User Role
+  on(AdminPanelActions.updateUserRole, (state) => ({
+    ...state,
+    isLoading: true,
+    errors: [],
+  })),
+
+  on(AdminPanelActions.updateUserRoleSuccess, (state) => ({
+    ...state,
+    isLoading: false,
+  })),
+
+  on(AdminPanelActions.updateUserRoleFailed, (state, { error }) => ({
+    ...state,
+    isLoading: false,
+    errors: [...state.errors, error],
+  })),
+
+  // Delete User
+  on(AdminPanelActions.deleteUser, (state) => ({
+    ...state,
+    isLoading: true,
+    errors: [],
+  })),
+
+  on(AdminPanelActions.deleteUserSuccess, (state) => ({
+    ...state,
+    isLoading: false,
+  })),
+
+  on(AdminPanelActions.deleteUserFailed, (state, { error }) => ({
+    ...state,
+    isLoading: false,
+    errors: [...state.errors, error],
+  })),
+
+  // Delete Group
+  on(AdminPanelActions.deleteGroup, (state) => ({
+    ...state,
+    isLoading: true,
+    errors: [],
+  })),
+
+  on(AdminPanelActions.deleteGroupSuccess, (state) => ({
+    ...state,
+    isLoading: false,
+  })),
+
+  on(AdminPanelActions.deleteGroupFailed, (state, { error }) => ({
+    ...state,
+    isLoading: false,
+    errors: [...state.errors, error],
+  })),
+
+  // Rename Group
+  on(AdminPanelActions.renameGroup, (state) => ({
+    ...state,
+    isLoading: true,
+    errors: [],
+  })),
+
+  on(AdminPanelActions.renameGroupSuccess, (state) => ({
+    ...state,
+    isLoading: false,
+  })),
+
+  on(AdminPanelActions.renameGroupFailed, (state, { error }) => ({
+    ...state,
+    isLoading: false,
+    errors: [...state.errors, error],
+  })),
+
+  // Clear Errors
+  on(AdminPanelActions.clearErrors, (state) => ({
+    ...state,
+    errors: [],
+  })),
+
+  // Tag Management - Toggle Tree Node
+  on(AdminPanelActions.toggleTreeNode, (state, { nodeId }) => {
+    const expandedNodes = state.expandedTreeNodes.includes(nodeId)
+      ? state.expandedTreeNodes.filter((id) => id !== nodeId)
+      : [...state.expandedTreeNodes, nodeId];
+    return {
+      ...state,
+      expandedTreeNodes: expandedNodes,
+    };
+  }),
+
+  // Tag Management - Set Update Mode
+  on(AdminPanelActions.setUpdateMode, (state, { mode }) => ({
+    ...state,
+    selectedUpdateMode: mode,
+  })),
+
+  // Tag Management - Update Share Role (track individual dropdowns, not global loading)
+  on(AdminPanelActions.updateShareRole, (state, { itemId, usertype }) => ({
+    ...state,
+    updatingRoles: [...state.updatingRoles, `${itemId}-${usertype}`],
+    errors: [],
+  })),
+
+  on(
+    AdminPanelActions.updateShareRoleSuccess,
+    (state, { itemId, usertype }) => ({
+      ...state,
+      updatingRoles: state.updatingRoles.filter(
+        (key) => key !== `${itemId}-${usertype}`,
+      ),
+    }),
+  ),
+
+  on(
+    AdminPanelActions.updateShareRoleFailed,
+    (state, { error, itemId, usertype }) => ({
+      ...state,
+      updatingRoles: state.updatingRoles.filter(
+        (key) => key !== `${itemId}-${usertype}`,
+      ),
+      errors: [...state.errors, error],
+    }),
+  ),
+
+  // Update item tags in store after successful webhook response
+  on(
+    AdminPanelActions.updateItemTags,
+    (state, { itemId, usertype, newRole, oldRole }) => {
+      if (!state.data) {
+        return state;
+      }
+
+      // Helper function to update tags on an item
+      const updateItemTags = (item: Item): Item => {
+        if (item.key !== itemId) {
+          return item;
+        }
+
+        const newItem = item.clone();
+        const tags = [...(newItem.tags || [])];
+
+        // Remove old tag if it exists
+        if (oldRole) {
+          if (usertype === "self") {
+            const oldTag = `hz-invite-self-${oldRole}`;
+            const oldIndex = tags.indexOf(oldTag);
+            if (oldIndex >= 0) {
+              tags.splice(oldIndex, 1);
+            }
+          } else {
+            const oldTag = `hz-share-${usertype}-${oldRole}`;
+            const oldIndex = tags.indexOf(oldTag);
+            if (oldIndex >= 0) {
+              tags.splice(oldIndex, 1);
+            }
+          }
+        } else {
+          // If oldRole is null, remove any existing tag for this usertype
+          // (in case there was a tag we didn't track)
+          if (usertype === "self") {
+            // Remove any hz-invite-self-* tag
+            const selfInviteTags = tags.filter((tag) =>
+              tag.startsWith("hz-invite-self-"),
+            );
+            selfInviteTags.forEach((tag) => {
+              const index = tags.indexOf(tag);
+              if (index >= 0) {
+                tags.splice(index, 1);
+              }
+            });
+          } else {
+            // Remove any hz-share-{usertype}-* tag
+            const shareTagPrefix = `hz-share-${usertype}-`;
+            const shareTags = tags.filter((tag) =>
+              tag.startsWith(shareTagPrefix),
+            );
+            shareTags.forEach((tag) => {
+              const index = tags.indexOf(tag);
+              if (index >= 0) {
+                tags.splice(index, 1);
+              }
+            });
+          }
+        }
+
+        // Add new tag (or remove if newRole is "none")
+        if (newRole && newRole !== "none") {
+          if (usertype === "self") {
+            const newTag = `hz-invite-self-${newRole}`;
+            if (!tags.includes(newTag)) {
+              tags.push(newTag);
+            }
+          } else {
+            const newTag = `hz-share-${usertype}-${newRole}`;
+            if (!tags.includes(newTag)) {
+              tags.push(newTag);
+            }
+          }
+        }
+        // If newRole is "none" or null, we've already removed the old tag above
+
+        newItem.tags = tags;
+        return newItem;
+      };
+
+      // Update items in templateData
+      const updatedTemplateData = state.data.templateData.map(updateItemTags);
+
+      // Update items in firstLevelData
+      const updatedFirstLevelData =
+        state.data.firstLevelData.map(updateItemTags);
+
+      // Update items in templateChildrenData
+      const updatedTemplateChildrenData: Record<string, Item[]> = {};
+      for (const [key, children] of Object.entries(
+        state.data.templateChildrenData,
+      )) {
+        updatedTemplateChildrenData[key] = children.map(updateItemTags);
+      }
+
+      return {
+        ...state,
+        data: {
+          ...state.data,
+          templateData: updatedTemplateData,
+          firstLevelData: updatedFirstLevelData,
+          templateChildrenData: updatedTemplateChildrenData,
+        },
+      };
+    },
+  ),
+);
