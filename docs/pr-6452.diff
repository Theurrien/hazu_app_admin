+import { HttpClient } from "@angular/common/http";
+import { Injectable } from "@angular/core";
+import { Auth } from "@angular/fire/auth";
+import { ItemDataService } from "@hazu/model/services/data/item.data.service";
+import { Item } from "@shared/model/Item";
+import { combineLatest, forkJoin, from, Observable, of } from "rxjs";
+import { catchError, map, switchMap, take } from "rxjs/operators";
+import { environment } from "../../../../environments/environment";
+import { AdminPanelData } from "../state/admin-panel.state";
+
+@Injectable({ providedIn: "root" })
+export class AdminPanelService {
+  private baseUrl = "";
+  private loadingInProgress = false;
+  private currentLoadingBaseItemKey: string | null = null;
+
+  constructor(
+    private readonly http: HttpClient,
+    private readonly afAuth: Auth,
+    private readonly itemDataService: ItemDataService,
+  ) {
+    this.baseUrl = environment.useEmulators?.functions
+      ? `http://localhost:5001/${
+          environment.FIREBASE_CONFIG?.projectId ?? "hazu-ch-dev"
+        }/${environment.emulatorSettings?.functions.region ?? "europe-west6"}/`
+      : `https://${environment.CLOUD_FUNCTIONS_REGION}-${
+          environment.FIREBASE_CONFIG?.projectId ?? "hazu-ch-dev"
+        }.cloudfunctions.net/`;
+  }
+
+  private getIdToken(): Promise<string> {
+    return this.afAuth.currentUser?.getIdToken() ?? Promise.resolve("");
+  }
+
+  /**
+   * Check if admin panel should be enabled for the current Hazu
+   * by checking if it has the hz-config-admin tag
+   */
+  shouldAdminPanelBeEnabled(baseItem: Item): boolean {
+    return baseItem?.tags?.some((tag) => tag === "hz-config-admin") ?? false;
+  }
+
+  /**
+   * Load admin panel data by aggregating from Firestore
+   * Following the structure from the Make scenario
+   */
+  loadAdminPanelData(baseItem: Item): Observable<AdminPanelData> {
+    const baseItemKey = baseItem.key;
+    console.log(
+      "[AdminPanelService] loadAdminPanelData CALLED with baseItem:",
+      {
+        id: baseItem.id,
+        key: baseItemKey,
+        title: baseItem.titleText,
+        loadingInProgress: this.loadingInProgress,
+        currentLoadingBaseItemKey: this.currentLoadingBaseItemKey,
+      },
+    );
+
+    // Prevent concurrent loads for the same baseItem
+    if (
+      this.loadingInProgress &&
+      this.currentLoadingBaseItemKey === baseItemKey
+    ) {
+      console.error(
+        "[AdminPanelService] loadAdminPanelData already in progress for this baseItem, returning empty observable",
+      );
+      return of({
+        firstLevelData: [],
+        templateData: [],
+        usertypeData: [],
+        hazuData: {},
+        templateChildrenData: {},
+        templateRoot: "",
+        parentId: "",
+        env: "swiss",
+      });
+    }
+
+    this.loadingInProgress = true;
+    this.currentLoadingBaseItemKey = baseItemKey;
+
+    // First, find the admin Hazu (either the baseItem itself or a child with hz-config-admin tag)
+    return this.findAdminHazu(baseItem).pipe(
+      switchMap((adminHazu) => {
+        if (!adminHazu) {
+          this.loadingInProgress = false;
+          this.currentLoadingBaseItemKey = null;
+          throw new Error("Admin Hazu not found");
+        }
+
+        // Step 1: Find the template root by navigating up to find parent with hz-config-school-template tag
+        return this.findTemplateRoot(adminHazu).pipe(
+          switchMap((templateRoot) => {
+            if (!templateRoot) {
+              throw new Error("Template root not found");
+            }
+
+            // Step 2: Get first level data (children of template root)
+            const firstLevelData$ = this.getFirstLevelData(
+              templateRoot.id || templateRoot.key,
+            );
+
+            // Step 3: Get template data (children of adminHazu with hz-config-templates tag)
+            const templateData$ = this.getTemplateData(
+              adminHazu.id || adminHazu.key,
+            );
+
+            // Step 4: Get user type data (children of adminHazu with hz-config-usertypes tag)
+            const usertypeData$ = this.getUsertypeData(
+              adminHazu.id || adminHazu.key,
+            );
+
+            return combineLatest([
+              firstLevelData$,
+              templateData$,
+              usertypeData$,
+            ]).pipe(
+              switchMap(([firstLevelData, templateData, usertypeData]) => {
+                // Step 5: Build hazuData map by getting children of each first-level item
+                const hazuDataMap$ = this.buildHazuDataMap(firstLevelData);
+
+                // Step 6: Load template children for tree view
+                const templateChildrenData$ =
+                  this.loadTemplateChildrenForTreeView(templateData);
+
+                return combineLatest([
+                  hazuDataMap$,
+                  templateChildrenData$,
+                ]).pipe(
+                  map(([hazuData, templateChildrenData]) => {
+                    const result = {
+                      firstLevelData,
+                      templateData,
+                      usertypeData,
+                      hazuData,
+                      templateChildrenData,
+                      templateRoot: templateRoot.id || templateRoot.key,
+                      parentId: adminHazu.id || adminHazu.key,
+                      env: environment.HOST.split(".").pop() ?? "swiss",
+                    };
+                    // Check for duplicates in final result
+                    const firstLevelKeys = new Set<string>();
+                    const firstLevelDuplicates: string[] = [];
+                    result.firstLevelData.forEach((item) => {
+                      if (firstLevelKeys.has(item.key)) {
+                        firstLevelDuplicates.push(item.key);
+                      } else {
+                        firstLevelKeys.add(item.key);
+                      }
+                    });
+
+                    if (firstLevelDuplicates.length > 0) {
+                      console.error(
+                        "[AdminPanelService] DUPLICATES IN FINAL firstLevelData:",
+                        firstLevelDuplicates,
+                      );
+                    }
+
+                    console.log("[AdminPanelService] Data loaded:", {
+                      firstLevel: result.firstLevelData.length,
+                      templates: result.templateData.length,
+                      usertypes: result.usertypeData.length,
+                      hazuDataKeys: Object.keys(result.hazuData).length,
+                      templateChildrenKeys: Object.keys(
+                        result.templateChildrenData,
+                      ).length,
+                      hasDuplicates: firstLevelDuplicates.length > 0,
+                    });
+                    this.loadingInProgress = false;
+                    this.currentLoadingBaseItemKey = null;
+                    return result;
+                  }),
+                );
+              }),
+            );
+          }),
+        );
+      }),
+      catchError((error) => {
+        console.error(
+          "[AdminPanelService] Error in loadAdminPanelData:",
+          error,
+        );
+        this.loadingInProgress = false;
+        this.currentLoadingBaseItemKey = null;
+        throw error;
+      }),
+    );
+  }
+
+  /**
+   * Find the admin Hazu (either the baseItem or a child with hz-config-admin tag)
+   */
+  private findAdminHazu(baseItem: Item): Observable<Item | null> {
+    // Check if the baseItem itself has the admin tag
+    if (baseItem.tags?.includes("hz-config-admin")) {
+      return of(baseItem);
+    }
+
+    // Otherwise, look for a child with the admin tag
+    return this.itemDataService.findChildren(baseItem.id).pipe(
+      take(1),
+      map((children) => {
+        return (
+          children.find((child) => child.tags?.includes("hz-config-admin")) ??
+          null
+        );
+      }),
+    );
+  }
+
+  /**
+   * Find the template root by checking parent items for hz-config-school-template tag
+   */
+  private findTemplateRoot(adminHazu: Item): Observable<Item> {
+    console.log(
+      "[AdminPanelService] findTemplateRoot - Starting with adminHazu parentId:",
+      adminHazu.parentId,
+    );
+    // Get the parent item (getItemOnce returns a Promise, so convert to Observable)
+    return from(this.itemDataService.getItemOnce(adminHazu.parentId)).pipe(
+      switchMap((parent) => {
+        if (!parent) {
+          throw new Error("Parent not found");
+        }
+
+        console.log("[AdminPanelService] findTemplateRoot - Found parent:", {
+          id: parent.id,
+          title: parent.titleText,
+          tags: parent.tags,
+          parentId: parent.parentId,
+        });
+
+        // Check if parent has the template tag
+        if (
+          parent.tags?.some((tag) =>
+            tag.startsWith("hz-config-school-template"),
+          )
+        ) {
+          console.log(
+            "[AdminPanelService] findTemplateRoot - Found template root:",
+            parent.id,
+          );
+          // The template root is the parent with the template tag
+          // Check if it has children with room/profile tags
+          return this.itemDataService.findChildren(parent.id).pipe(
+            take(1),
+            map((children) => {
+              const hasRoomOrProfileChildren = children.some(
+                (child) =>
+                  child.tags?.some(
+                    (tag) =>
+                      tag.startsWith("hz-config-room") ||
+                      tag.startsWith("hz-config-profile"),
+                  ),
+              );
+
+              console.log(
+                "[AdminPanelService] findTemplateRoot - Template root children count:",
+                children.length,
+              );
+              console.log(
+                "[AdminPanelService] findTemplateRoot - Has room/profile children:",
+                hasRoomOrProfileChildren,
+              );
+
+              if (hasRoomOrProfileChildren) {
+                return parent;
+              }
+
+              // If no room/profile children, check if any child has the template tag and use that instead
+              const childWithTemplateTag = children.find(
+                (child) =>
+                  child.tags?.some((tag) =>
+                    tag.startsWith("hz-config-school-template"),
+                  ),
+              );
+
+              if (childWithTemplateTag) {
+                console.log(
+                  "[AdminPanelService] findTemplateRoot - Using child with template tag:",
+                  childWithTemplateTag.id,
+                );
+                return childWithTemplateTag;
+              }
+
+              // Otherwise, return the parent anyway (it might be correct)
+              return parent;
+            }),
+          );
+        }
+
+        // If not, recursively check the parent's parent
+        if (parent.parentId) {
+          console.log(
+            "[AdminPanelService] findTemplateRoot - Recursing to parent's parent:",
+            parent.parentId,
+          );
+          return this.findTemplateRoot(parent);
+        }
+
+        throw new Error("Template root not found in parent hierarchy");
+      }),
+    );
+  }
+
+  /**
+   * Deduplicate items by key - fixes issue where findChildren returns duplicates
+   * This is a workaround for an issue in the data service layer
+   */
+  private deduplicateByKey(items: Item[]): Item[] {
+    const seen = new Set<string>();
+    return items.filter((item) => {
+      if (seen.has(item.key)) {
+        return false;
+      }
+      seen.add(item.key);
+      return true;
+    });
+  }
+
+  /**
+   * Get first level data (children of template root)
+   */
+  private getFirstLevelData(templateRootId: string): Observable<Item[]> {
+    console.log(
+      "[AdminPanelService] getFirstLevelData - Querying for children of templateRootId:",
+      templateRootId,
+    );
+    return this.itemDataService.findChildren(templateRootId).pipe(
+      take(1),
+      map((items) => {
+        // Deduplicate at source - findChildren sometimes returns duplicates
+        const uniqueItems = this.deduplicateByKey(items);
+
+        if (items.length !== uniqueItems.length) {
+          console.warn(
+            `[AdminPanelService] getFirstLevelData - Deduplicated ${
+              items.length - uniqueItems.length
+            } duplicate items from findChildren result`,
+          );
+        }
+
+        console.log(
+          "[AdminPanelService] getFirstLevelData - Found children count:",
+          uniqueItems.length,
+        );
+
+        // First level data should only include rooms and profiles, NOT the admin hazu
+        const filtered = uniqueItems.filter((item) => {
+          const hasMatchingTag =
+            item.tags?.some(
+              (tag) =>
+                tag.startsWith("hz-config-room") ||
+                tag.startsWith("hz-config-profile"),
+            ) ?? false;
+          return hasMatchingTag;
+        });
+
+        console.log(
+          "[AdminPanelService] getFirstLevelData - Filtered items count:",
+          filtered.length,
+        );
+        return filtered;
+      }),
+    );
+  }
+
+  /**
+   * Get template data (children of adminHazu with hz-config-templates tag)
+   */
+  private getTemplateData(adminHazuId: string): Observable<Item[]> {
+    console.log(
+      "[AdminPanelService] getTemplateData - Querying for children of adminHazuId:",
+      adminHazuId,
+    );
+    return this.itemDataService.findChildren(adminHazuId).pipe(
+      take(1),
+      switchMap((children) => {
+        console.log(
+          "[AdminPanelService] getTemplateData - Admin hazu children count:",
+          children.length,
+        );
+
+        const templatesHazu = children.find(
+          (c) => c.tags?.includes("hz-config-templates"),
+        );
+
+        if (!templatesHazu) {
+          console.log(
+            "[AdminPanelService] getTemplateData - No templatesHazu found",
+          );
+          return of([]);
+        }
+
+        const templatesHazuId = templatesHazu.id || templatesHazu.key;
+        console.log(
+          "[AdminPanelService] getTemplateData - Found templatesHazu:",
+          {
+            id: templatesHazu.id,
+            key: templatesHazu.key,
+            title: templatesHazu.titleText,
+            tags: templatesHazu.tags,
+          },
+        );
+        console.log(
+          "[AdminPanelService] getTemplateData - Querying children of templatesHazuId:",
+          templatesHazuId,
+        );
+
+        return this.itemDataService.findChildren(templatesHazuId).pipe(
+          take(1),
+          map((templates) => {
+            // Deduplicate at source
+            const uniqueTemplates = this.deduplicateByKey(templates);
+
+            if (templates.length !== uniqueTemplates.length) {
+              console.warn(
+                `[AdminPanelService] getTemplateData - Deduplicated ${
+                  templates.length - uniqueTemplates.length
+                } duplicate templates`,
+              );
+            }
+
+            console.log(
+              "[AdminPanelService] getTemplateData - Found templates count:",
+              uniqueTemplates.length,
+            );
+
+            // Filter templates that have room or profile tags
+            const filtered = uniqueTemplates.filter(
+              (t) =>
+                t.tags?.some(
+                  (tag) =>
+                    tag.startsWith("hz-config-room") ||
+                    tag.startsWith("hz-config-profile"),
+                ) ?? false,
+            );
+
+            console.log(
+              "[AdminPanelService] getTemplateData - Filtered templates count:",
+              filtered.length,
+            );
+            return filtered;
+          }),
+        );
+      }),
+    );
+  }
+
+  /**
+   * Get usertype data (children of adminHazu with hz-config-usertypes tag)
+   */
+  private getUsertypeData(adminHazuId: string): Observable<Item[]> {
+    console.log(
+      "[AdminPanelService] getUsertypeData - Querying for children of adminHazuId:",
+      adminHazuId,
+    );
+    return this.itemDataService.findChildren(adminHazuId).pipe(
+      take(1),
+      switchMap((children) => {
+        console.log(
+          "[AdminPanelService] getUsertypeData - Admin hazu children count:",
+          children.length,
+        );
+
+        const usertypesHazu = children.find(
+          (c) => c.tags?.includes("hz-config-usertypes"),
+        );
+
+        if (!usertypesHazu) {
+          console.log(
+            "[AdminPanelService] getUsertypeData - No usertypesHazu found",
+          );
+          return of([]);
+        }
+
+        const usertypesHazuId = usertypesHazu.id || usertypesHazu.key;
+        console.log(
+          "[AdminPanelService] getUsertypeData - Found usertypesHazu:",
+          {
+            id: usertypesHazu.id,
+            key: usertypesHazu.key,
+            title: usertypesHazu.titleText,
+            tags: usertypesHazu.tags,
+          },
+        );
+        console.log(
+          "[AdminPanelService] getUsertypeData - Querying children of usertypesHazuId:",
+          usertypesHazuId,
+        );
+
+        return this.itemDataService.findChildren(usertypesHazuId).pipe(
+          take(1),
+          map((usertypes) => {
+            // Deduplicate at source
+            const uniqueUsertypes = this.deduplicateByKey(usertypes);
+
+            if (usertypes.length !== uniqueUsertypes.length) {
+              console.warn(
+                `[AdminPanelService] getUsertypeData - Deduplicated ${
+                  usertypes.length - uniqueUsertypes.length
+                } duplicate usertypes`,
+              );
+            }
+
+            console.log(
+              "[AdminPanelService] getUsertypeData - Found usertypes count:",
+              uniqueUsertypes.length,
+            );
+            return uniqueUsertypes;
+          }),
+        );
+      }),
+    );
+  }
+
+  /**
+   * Build hazuData map by fetching children of each first-level item
+   */
+  private buildHazuDataMap(
+    firstLevelData: Item[],
+  ): Observable<Record<string, Item[]>> {
+    if (firstLevelData.length === 0) {
+      return of({});
+    }
+
+    const childrenObservables = firstLevelData.map((item) => {
+      const itemKey = item.key;
+      return this.itemDataService.findChildren(itemKey).pipe(
+        take(1),
+        map((children) => {
+          return { [itemKey]: children };
+        }),
+      );
+    });
+
+    return forkJoin(childrenObservables).pipe(
+      map((results) => Object.assign({}, ...results)),
+    );
+  }
+
+  /**
+   * Add a new group (class/room)
+   */
+  async addGroup(data: {
+    type: string;
+    template: string;
+    title: string;
+    templateRoot: string;
+    parentId: string;
+    env: string;
+  }): Promise<string> {
+    const token = await this.getIdToken();
+    const response = await this.http
+      .post<{ groupId: string }>(
+        `${this.baseUrl}api-v2/admin/create-group`,
+        data,
+        {
+          headers: {
+            Authorization: `Bearer ${token}`,
+            "Content-Type": "application/json",
+          },
+        },
+      )
+      .toPromise();
+    return response?.groupId ?? "";
+  }
+
+  /**
+   * Add a new user
+   */
+  async addUser(data: {
+    type: string;
+    template: string;
+    firstName: string;
+    lastName: string;
+    email: string;
+    classes: Record<string, { selected: boolean; userType: string }>;
+    guardian1Email: string;
+    guardian2Email: string;
+    sendInvitationMail: boolean;
+    templateRoot: string;
+    parentId: string;
+    env: string;
+  }): Promise<string> {
+    const token = await this.getIdToken();
+    const response = await this.http
+      .post<{ userId: string }>(`${this.baseUrl}api-v2/admin/add-user`, data, {
+        headers: {
+          Authorization: `Bearer ${token}`,
+          "Content-Type": "application/json",
+        },
+      })
+      .toPromise();
+    return response?.userId ?? "";
+  }
+
+  /**
+   * Update user roles
+   */
+  async updateUserRoles(data: {
+    userId: string;
+    classId: string;
+    role: string;
+    env: string;
+  }): Promise<void> {
+    const token = await this.getIdToken();
+    await this.http
+      .post(`${this.baseUrl}api-v2/admin/update-user-roles`, data, {
+        headers: {
+          Authorization: `Bearer ${token}`,
+          "Content-Type": "application/json",
+        },
+      })
+      .toPromise();
+  }
+
+  /**
+   * Remove a user
+   */
+  async removeUser(profileId: string, templateId: string): Promise<void> {
+    const token = await this.getIdToken();
+    await this.http
+      .post(
+        `${this.baseUrl}api-v2/admin/remove-user`,
+        { profileId, templateId },
+        {
+          headers: {
+            Authorization: `Bearer ${token}`,
+            "Content-Type": "application/json",
+          },
+        },
+      )
+      .toPromise();
+  }
+
+  /**
+   * Remove a group
+   */
+  async removeGroup(groupId: string, templateId: string): Promise<void> {
+    const token = await this.getIdToken();
+    await this.http
+      .post(
+        `${this.baseUrl}api-v2/admin/remove-group`,
+        { groupId, templateId },
+        {
+          headers: {
+            Authorization: `Bearer ${token}`,
+            "Content-Type": "application/json",
+          },
+        },
+      )
+      .toPromise();
+  }
+
+  /**
+   * Rename a group (updates Firestore directly)
+   */
+  async renameGroup(groupId: string, name: string): Promise<void> {
+    const item = await this.itemDataService.getItemOnce(groupId);
+    if (item) {
+      item.title = `<p>${name}</p>`;
+      await this.itemDataService.updateMany([item]);
+    }
+  }
+
+  /**
+   * Load template children (second level) for tree view
+   * Returns children of each template item
+   */
+  loadTemplateChildrenForTreeView(
+    templates: Item[],
+  ): Observable<Record<string, Item[]>> {
+    if (templates.length === 0) return of({});
+
+    const childrenObservables = templates.map((template) => {
+      return this.itemDataService.findChildren(template.key).pipe(
+        take(1),
+        map((children) => ({ [template.key]: children })),
+      );
+    });
+
+    return forkJoin(childrenObservables).pipe(
+      map((results) => Object.assign({}, ...results)),
+    );
+  }
+}
diff --git a/angular/hazu-app/src/app/features/admin-panel/state/admin-panel.actions.ts b/angular/hazu-app/src/app/features/admin-panel/state/admin-panel.actions.ts
