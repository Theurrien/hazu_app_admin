+
+  /**
+   * Open dropdown menu (for click)
+   */
+  openDropdown(event: Event): void {
+    event.stopPropagation();
+    const dropdown = event.currentTarget as HTMLElement;
+    this.toggleDropdown(dropdown);
+  }
+
+  /**
+   * Toggle dropdown open/close state
+   */
+  private toggleDropdown(dropdown: HTMLElement): void {
+    const wasActive = dropdown.classList.contains("active");
+
+    // Close all other dropdowns
+    this.closeAllDropdowns();
+
+    if (!wasActive) {
+      dropdown.classList.add("active", "visible");
+      dropdown.querySelector(".menu")?.classList.add("visible");
+      // Highlight the currently active item or first item
+      const activeItem = dropdown.querySelector(
+        ".menu .item.active",
+      ) as HTMLElement;
+      const firstItem = dropdown.querySelector(".menu .item") as HTMLElement;
+      const itemToHighlight = activeItem || firstItem;
+      if (itemToHighlight) {
+        this.highlightDropdownItem(itemToHighlight);
+      }
+    }
+  }
+
+  /**
+   * Highlight a dropdown item (for keyboard navigation)
+   */
+  private highlightDropdownItem(item: HTMLElement): void {
+    // Remove highlight from all items in the same menu
+    const menu = item.closest(".menu");
+    menu?.querySelectorAll(".item").forEach((el) => {
+      el.classList.remove("highlighted");
+    });
+    item.classList.add("highlighted");
+    item.scrollIntoView({ block: "nearest" });
+  }
+
+  /**
+   * Close all open dropdowns
+   */
+  closeAllDropdowns(): void {
+    document.querySelectorAll(".role-dropdown.active").forEach((el) => {
+      el.classList.remove("active", "visible");
+      el.querySelector(".menu")?.classList.remove("visible");
+      el.querySelectorAll(".item.highlighted").forEach((item) => {
+        item.classList.remove("highlighted");
+      });
+    });
+  }
+
+  /**
+   * Handle keyboard events on dropdown trigger (Google Sheets-like)
+   * - Enter: Open dropdown or select highlighted item
+   * - Arrow keys: Navigate between cells or within dropdown
+   */
+  onDropdownKeydown(event: KeyboardEvent, dropdown: HTMLElement): void {
+    const isOpen = dropdown.classList.contains("active");
+
+    if (event.key === "Enter" || event.key === " ") {
+      event.preventDefault();
+      event.stopPropagation(); // Prevent row toggle when pressing Enter on dropdown
+      if (!isOpen) {
+        this.toggleDropdown(dropdown);
+      } else {
+        // Select the highlighted item
+        const highlighted = dropdown.querySelector(
+          ".menu .item.highlighted",
+        ) as HTMLElement;
+        if (highlighted) {
+          highlighted.click();
+          this.closeAllDropdowns();
+          dropdown.focus();
+        }
+      }
+    } else if (event.key === "Escape") {
+      event.stopPropagation();
+      if (isOpen) {
+        this.closeAllDropdowns();
+        dropdown.focus();
+      }
+    } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
+      event.preventDefault();
+      event.stopPropagation(); // Prevent row toggle
+      if (isOpen) {
+        this.navigateDropdownItems(dropdown, event.key === "ArrowDown");
+      } else {
+        // Navigate to next/prev row (vertical = true, forward = ArrowDown)
+        this.navigateToAdjacentCell(dropdown, true, event.key === "ArrowDown");
+      }
+    } else if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
+      if (!isOpen) {
+        event.preventDefault();
+        event.stopPropagation();
+        this.navigateToAdjacentCell(
+          dropdown,
+          false,
+          event.key === "ArrowRight",
+        );
+      }
+    } else if (event.key === "Tab") {
+      if (isOpen) {
+        this.closeAllDropdowns();
+      }
+      // Let default tab behavior work
+    }
+  }
+
+  /**
+   * Navigate within dropdown items using arrow keys
+   */
+  private navigateDropdownItems(
+    dropdown: HTMLElement,
+    moveDown: boolean,
+  ): void {
+    const items = Array.from(
+      dropdown.querySelectorAll(".menu .item"),
+    ) as HTMLElement[];
+    const highlighted = dropdown.querySelector(
+      ".menu .item.highlighted",
+    ) as HTMLElement;
+    let currentIndex = highlighted ? items.indexOf(highlighted) : -1;
+
+    if (moveDown) {
+      currentIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
+    } else {
+      currentIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
+    }
+
+    if (items[currentIndex]) {
+      this.highlightDropdownItem(items[currentIndex]);
+    }
+  }
+
+  /**
+   * Navigate to adjacent cell (for arrow key navigation between cells)
+   */
+  private navigateToAdjacentCell(
+    currentDropdown: HTMLElement,
+    vertical: boolean,
+    forward: boolean = true,
+  ): void {
+    const allDropdowns = Array.from(
+      document.querySelectorAll(".role-dropdown"),
+    ) as HTMLElement[];
+    const currentIndex = allDropdowns.indexOf(currentDropdown);
+
+    if (currentIndex === -1) return;
+
+    // For horizontal navigation, just move to next/prev dropdown
+    if (!vertical) {
+      const nextIndex = forward ? currentIndex + 1 : currentIndex - 1;
+      if (nextIndex >= 0 && nextIndex < allDropdowns.length) {
+        allDropdowns[nextIndex].focus();
+      }
+      return;
+    }
+
+    // For vertical navigation, try to find dropdown in same column of next row
+    const currentCell = currentDropdown.closest("td");
+    const currentRow = currentCell?.closest("tr");
+    if (!currentRow) return;
+
+    const targetRow = forward
+      ? (currentRow.nextElementSibling as HTMLElement)
+      : (currentRow.previousElementSibling as HTMLElement);
+    if (!targetRow) return;
+
+    // Find cell at same position
+    const cells = Array.from(currentRow.querySelectorAll("td")) as Element[];
+    const cellIndex = currentCell ? cells.indexOf(currentCell) : -1;
+
+    const targetCells = Array.from(targetRow.querySelectorAll("td"));
+    const targetCell = targetCells[cellIndex] as HTMLElement;
+    const targetDropdown = targetCell?.querySelector(
+      ".role-dropdown",
+    ) as HTMLElement;
+
+    if (targetDropdown) {
+      targetDropdown.focus();
+    } else if (targetRow.hasAttribute("tabindex")) {
+      // Focus the row if it's expandable
+      targetRow.focus();
+    }
+  }
+}
