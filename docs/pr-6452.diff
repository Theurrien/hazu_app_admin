@@ -0,0 +1,366 @@
+import { Injectable } from "@angular/core";
+import { showToast } from "@hazu/toast/state/toast.actions";
+import { Actions, createEffect, ofType } from "@ngrx/effects";
+import { Store } from "@ngrx/store";
+import { of, timer } from "rxjs";
+import {
+  catchError,
+  exhaustMap,
+  filter,
+  map,
+  mergeMap,
+  switchMap,
+  withLatestFrom,
+} from "rxjs/operators";
+import { AdminPanelService } from "../services/admin-panel.service";
+import * as AdminPanelActions from "./admin-panel.actions";
+import {
+  selectAdminPanelBaseItem,
+  selectAdminPanelData,
+} from "./admin-panel.selectors";
+
+@Injectable()
+export class AdminPanelEffects {
+  constructor(
+    private actions$: Actions,
+    private store: Store,
+    private adminPanelService: AdminPanelService,
+  ) {}
+
+  loadAdminData$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.loadAdminData),
+      withLatestFrom(
+        this.store.select(selectAdminPanelBaseItem),
+        this.store.select(selectAdminPanelData),
+      ),
+      // Only proceed if data is not already loaded for the same baseItem
+      // exhaustMap already prevents concurrent loads
+      filter(([{ baseItem }, currentBaseItem, currentData]) => {
+        console.log("[AdminPanelEffects] Filter check:", {
+          baseItemKey: baseItem.key,
+          currentBaseItemKey: currentBaseItem?.key,
+          hasCurrentData: currentData !== null,
+        });
+
+        // Skip if data is already loaded for the same baseItem
+        if (currentBaseItem?.key === baseItem.key && currentData !== null) {
+          console.log(
+            "[AdminPanelEffects] Data already loaded for this baseItem, skipping",
+          );
+          return false;
+        }
+
+        console.log("[AdminPanelEffects] Proceeding with load");
+        return true;
+      }),
+      // Use exhaustMap to prevent concurrent loads (ignores new requests while one is in progress)
+      exhaustMap(([{ baseItem }]) => {
+        console.log(
+          "[AdminPanelEffects] loadAdminData action received, baseItem:",
+          baseItem,
+        );
+        return this.adminPanelService.loadAdminPanelData(baseItem).pipe(
+          map((data) => {
+            console.log(
+              "[AdminPanelEffects] Data loaded successfully, dispatching adminDataLoaded:",
+              {
+                firstLevel: data.firstLevelData.length,
+                templates: data.templateData.length,
+                usertypes: data.usertypeData.length,
+                hazuDataKeys: Object.keys(data.hazuData).length,
+              },
+            );
+            return AdminPanelActions.adminDataLoaded({ data });
+          }),
+          catchError((error) => {
+            console.error(
+              "[AdminPanelEffects] Error loading admin data:",
+              error,
+            );
+            return of(
+              AdminPanelActions.adminDataLoadFailed({
+                error: error.message || "Failed to load admin data",
+              }),
+            );
+          }),
+        );
+      }),
+    ),
+  );
+
+  submitAddGroup$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.submitAddGroup),
+      withLatestFrom(this.store.select(selectAdminPanelData)),
+      switchMap(([{ formData }, adminData]) => {
+        if (!adminData) {
+          return of(
+            AdminPanelActions.addGroupFailed({
+              error: "Admin data not loaded",
+            }),
+          );
+        }
+
+        return this.adminPanelService
+          .addGroup({
+            ...formData,
+            templateRoot: adminData.templateRoot,
+            parentId: adminData.parentId,
+            env: adminData.env,
+          })
+          .then((groupId) => AdminPanelActions.addGroupSuccess({ groupId }))
+          .catch((error) =>
+            AdminPanelActions.addGroupFailed({
+              error: error.message || "Failed to add group",
+            }),
+          );
+      }),
+    ),
+  );
+
+  addGroupSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.addGroupSuccess),
+      withLatestFrom(this.store.select(selectAdminPanelBaseItem)),
+      switchMap(([{ groupId }, baseItem]) => [
+        showToast("ADMIN_PANEL.ADD_GROUP.SUCCESS", "success", 3000),
+        // Reload admin data to reflect the new group
+        ...(baseItem ? [AdminPanelActions.loadAdminData({ baseItem })] : []),
+      ]),
+    ),
+  );
+
+  submitAddUser$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.submitAddUser),
+      withLatestFrom(this.store.select(selectAdminPanelData)),
+      switchMap(([{ formData }, adminData]) => {
+        if (!adminData) {
+          return of(
+            AdminPanelActions.addUserFailed({ error: "Admin data not loaded" }),
+          );
+        }
+
+        return this.adminPanelService
+          .addUser({
+            ...formData,
+            templateRoot: adminData.templateRoot,
+            parentId: adminData.parentId,
+            env: adminData.env,
+          })
+          .then((userId) => AdminPanelActions.addUserSuccess({ userId }))
+          .catch((error) =>
+            AdminPanelActions.addUserFailed({
+              error: error.message || "Failed to add user",
+            }),
+          );
+      }),
+    ),
+  );
+
+  addUserSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.addUserSuccess),
+      withLatestFrom(this.store.select(selectAdminPanelBaseItem)),
+      switchMap(([, baseItem]) => [
+        showToast("ADMIN_PANEL.ADD_USER.SUCCESS", "success", 3000),
+        // Reload admin data to reflect the new user
+        ...(baseItem ? [AdminPanelActions.loadAdminData({ baseItem })] : []),
+      ]),
+    ),
+  );
+
+  updateUserRole$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.updateUserRole),
+      withLatestFrom(this.store.select(selectAdminPanelData)),
+      switchMap(([{ userId, classId, role }, adminData]) => {
+        if (!adminData) {
+          return of(
+            AdminPanelActions.updateUserRoleFailed({
+              error: "Admin data not loaded",
+            }),
+          );
+        }
+
+        return this.adminPanelService
+          .updateUserRoles({
+            userId,
+            classId,
+            role,
+            env: adminData.env,
+          })
+          .then(() => AdminPanelActions.updateUserRoleSuccess())
+          .catch((error) =>
+            AdminPanelActions.updateUserRoleFailed({
+              error: error.message || "Failed to update user role",
+            }),
+          );
+      }),
+    ),
+  );
+
+  updateUserRoleSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.updateUserRoleSuccess),
+      map(() =>
+        showToast("ADMIN_PANEL.GROUP_MANAGEMENT.ROLE_UPDATED", "success", 3000),
+      ),
+    ),
+  );
+
+  deleteUser$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.deleteUser),
+      switchMap(({ userId, templateId }) =>
+        this.adminPanelService
+          .removeUser(userId, templateId)
+          .then(() => AdminPanelActions.deleteUserSuccess({ userId }))
+          .catch((error) =>
+            AdminPanelActions.deleteUserFailed({
+              error: error.message || "Failed to delete user",
+            }),
+          ),
+      ),
+    ),
+  );
+
+  deleteUserSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.deleteUserSuccess),
+      withLatestFrom(this.store.select(selectAdminPanelBaseItem)),
+      switchMap(([, baseItem]) => [
+        showToast("ADMIN_PANEL.GROUP_MANAGEMENT.USER_DELETED", "success", 3000),
+        ...(baseItem ? [AdminPanelActions.loadAdminData({ baseItem })] : []),
+      ]),
+    ),
+  );
+
+  deleteGroup$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.deleteGroup),
+      switchMap(({ groupId, templateId }) =>
+        this.adminPanelService
+          .removeGroup(groupId, templateId)
+          .then(() => AdminPanelActions.deleteGroupSuccess({ groupId }))
+          .catch((error) =>
+            AdminPanelActions.deleteGroupFailed({
+              error: error.message || "Failed to delete group",
+            }),
+          ),
+      ),
+    ),
+  );
+
+  deleteGroupSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.deleteGroupSuccess),
+      withLatestFrom(this.store.select(selectAdminPanelBaseItem)),
+      switchMap(([, baseItem]) => [
+        showToast(
+          "ADMIN_PANEL.GROUP_MANAGEMENT.GROUP_DELETED",
+          "success",
+          3000,
+        ),
+        ...(baseItem ? [AdminPanelActions.loadAdminData({ baseItem })] : []),
+      ]),
+    ),
+  );
+
+  renameGroup$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.renameGroup),
+      switchMap(({ groupId, name }) =>
+        this.adminPanelService
+          .renameGroup(groupId, name)
+          .then(() => AdminPanelActions.renameGroupSuccess({ groupId, name }))
+          .catch((error) =>
+            AdminPanelActions.renameGroupFailed({
+              error: error.message || "Failed to rename group",
+            }),
+          ),
+      ),
+    ),
+  );
+
+  renameGroupSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.renameGroupSuccess),
+      withLatestFrom(this.store.select(selectAdminPanelBaseItem)),
+      switchMap(([, baseItem]) => [
+        showToast(
+          "ADMIN_PANEL.GROUP_MANAGEMENT.GROUP_RENAMED",
+          "success",
+          3000,
+        ),
+        ...(baseItem ? [AdminPanelActions.loadAdminData({ baseItem })] : []),
+      ]),
+    ),
+  );
+
+  // Tag Management - Update Share Role
+  // For now, just simulates success. In the future, this will call the n8n webhook.
+  updateShareRole$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.updateShareRole),
+      mergeMap(({ itemId, usertype, newRole, mode }) => {
+        console.log("[AdminPanelEffects] updateShareRole action received:", {
+          itemId,
+          usertype,
+          newRole,
+          mode,
+        });
+
+        // TODO: Replace this with actual webhook call
+        // For now, simulate a successful update after a short delay
+        return timer(500).pipe(
+          map(() => {
+            console.log(
+              "[AdminPanelEffects] updateShareRole simulated success",
+            );
+            return AdminPanelActions.updateShareRoleSuccess({
+              itemId,
+              usertype,
+            });
+          }),
+          catchError((error) => {
+            console.error("[AdminPanelEffects] updateShareRole error:", error);
+            return of(
+              AdminPanelActions.updateShareRoleFailed({
+                error: error.message || "Failed to update share role",
+                itemId,
+                usertype,
+              }),
+            );
+          }),
+        );
+      }),
+    ),
+  );
+
+  updateShareRoleSuccess$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(AdminPanelActions.updateShareRoleSuccess),
+      map(() =>
+        showToast("ADMIN_PANEL.TAG_MANAGEMENT.ROLE_UPDATED", "success", 3000),
+      ),
+    ),
+  );
+
+  showError$ = createEffect(() =>
+    this.actions$.pipe(
+      ofType(
+        AdminPanelActions.adminDataLoadFailed,
+        AdminPanelActions.addGroupFailed,
+        AdminPanelActions.addUserFailed,
+        AdminPanelActions.updateUserRoleFailed,
+        AdminPanelActions.deleteUserFailed,
+        AdminPanelActions.deleteGroupFailed,
+        AdminPanelActions.renameGroupFailed,
+        AdminPanelActions.updateShareRoleFailed,
+      ),
+      map(({ error }) => showToast(error, "error", 5000)),
+    ),
+  );
+}
diff --git a/angular/hazu-app/src/app/features/admin-panel/state/admin-panel.reducer.ts b/angular/hazu-app/src/app/features/admin-panel/state/admin-panel.reducer.ts
