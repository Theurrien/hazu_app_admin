+import { CommonModule } from "@angular/common";
+import { NgModule } from "@angular/core";
+import { FormsModule, ReactiveFormsModule } from "@angular/forms";
+import { SharedModule } from "@hazu/shared";
+import { FomanticUIModule } from "@hazuinc/ngx-fomantic-ui";
+import { TranslateModule } from "@ngx-translate/core";
+import { AdminPanelViewComponent } from "./admin-panel-view/admin-panel-view.component";
+import { AddGroupTabComponent } from "./components/add-group-tab/add-group-tab.component";
+import { AddUserTabComponent } from "./components/add-user-tab/add-user-tab.component";
+import { GroupManagementTabComponent } from "./components/group-management-tab/group-management-tab.component";
+import { TagManagementTabComponent } from "./components/tag-management-tab/tag-management-tab.component";
+
+@NgModule({
+  declarations: [
+    AdminPanelViewComponent,
+    TagManagementTabComponent,
+    AddGroupTabComponent,
+    AddUserTabComponent,
+    GroupManagementTabComponent,
+  ],
+  imports: [
+    CommonModule,
+    FormsModule,
+    ReactiveFormsModule,
+    SharedModule,
+    FomanticUIModule,
+    TranslateModule.forChild(),
+    // StoreModule and EffectsModule are registered globally in app.module.ts
+    // so state and effects are available before module loads
+    // AdminPanelService is providedIn: 'root', so no need to add it here
+  ],
+  exports: [AdminPanelViewComponent],
+})
+export class AdminPanelModule {}
