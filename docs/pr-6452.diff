+<ng-container [ngSwitch]="viewMode()">
+  <hz-modal
+    *ngSwitchCase="'modal'"
+    [isFullScreen]="true"
+    [isScrolling]="true"
+    (onClose)="onClose()"
+    modalClass="top aligned fullscreen hz-closeable-modal hz-admin-panel-view"
+  >
+    <header>
+      <div class="ui fluid secondary menu admin-panel-header">
+        <div class="item header">
+          <i class="sitemap icon"></i> {{ "ADMIN_PANEL.TITLE" | translate }}
+        </div>
+
+        <!-- Tabs in header -->
+        <a
+          class="tab item"
+          [class.active]="activeTab() === 'overview'"
+          (click)="setActiveTab('overview')"
+        >
+          <i class="fas fa-th-list"></i>
+          {{ "ADMIN_PANEL.TAG_MANAGEMENT.TITLE" | translate }}
+        </a>
+        <a
+          class="tab item"
+          [class.active]="activeTab() === 'add-group'"
+          (click)="setActiveTab('add-group')"
+        >
+          <i class="fas fa-plus-circle"></i>
+          {{ "ADMIN_PANEL.ADD_GROUP.TITLE" | translate }}
+        </a>
+        <a
+          class="tab item"
+          [class.active]="activeTab() === 'add-user'"
+          (click)="setActiveTab('add-user')"
+        >
+          <i class="fas fa-user-plus"></i>
+          {{ "ADMIN_PANEL.ADD_USER.TITLE" | translate }}
+        </a>
+        <a
+          class="tab item"
+          [class.active]="activeTab() === 'group-management'"
+          (click)="setActiveTab('group-management')"
+        >
+          <i class="fas fa-users"></i>
+          {{ "ADMIN_PANEL.GROUP_MANAGEMENT.TITLE" | translate }}
+        </a>
+      </div>
+    </header>
+
+    <content>
+      <div class="ui main container">
+        <!-- Loading state -->
+        <div class="ui message info" *ngIf="isLoading()">
+          <div class="ui active inline loader"></div>
+          {{ "LOADING" | translate }}
+        </div>
+
+        <!-- Error state -->
+        <div
+          class="ui message error"
+          *ngIf="!isLoading() && !adminData() && errors().length > 0"
+        >
+          <div class="header">{{ "ERROR" | translate }}</div>
+          <p>{{ errors()[0] }}</p>
+        </div>
+
+        <!-- Content -->
+        <div *ngIf="!isLoading() && adminData()" class="tab-content-area">
+          <!-- Tab content -->
+          <div class="tab-panel" [class.active]="activeTab() === 'overview'">
+            <hz-tag-management-tab
+              #tagManagementTab
+              [adminData]="adminData()!"
+            ></hz-tag-management-tab>
+          </div>
+
+          <div class="tab-panel" [class.active]="activeTab() === 'add-group'">
+            <hz-add-group-tab [adminData]="adminData()!"></hz-add-group-tab>
+          </div>
+
+          <div class="tab-panel" [class.active]="activeTab() === 'add-user'">
+            <hz-add-user-tab [adminData]="adminData()!"></hz-add-user-tab>
+          </div>
+
+          <div
+            class="tab-panel"
+            [class.active]="activeTab() === 'group-management'"
+          >
+            <hz-group-management-tab
+              [adminData]="adminData()!"
+            ></hz-group-management-tab>
+          </div>
+        </div>
+      </div>
+    </content>
+
+    <!-- Bottom action bar - outside scrolling content like skills modal -->
+    <div
+      class="actions"
+      *ngIf="
+        !isLoading() &&
+        adminData() &&
+        activeTab() === 'overview' &&
+        tagManagementTab
+      "
+    >
+      <div class="action-bar">
+        <div class="left-section">
+          <!-- Update mode selector -->
+          <div class="mode-selector">
+            <label>{{
+              "ADMIN_PANEL.TAG_MANAGEMENT.UPDATE_MODE" | translate
+            }}</label>
+            <select
+              class="ui dropdown mode-dropdown"
+              [ngModel]="tagManagementTab.selectedMode()"
+              (ngModelChange)="tagManagementTab.setMode($event)"
+              [disabled]="tagManagementTab.isSubmitting()"
+            >
+              @for (
+                option of tagManagementTab.translatedModeOptions();
+                track option.value
+              ) {
+                <option [value]="option.value">{{ option.label }}</option>
+              }
+            </select>
+          </div>
+
+          <!-- Changes preview -->
+          <div class="changes-preview">
+            @if (tagManagementTab.pendingChangesCount() > 0) {
+              <span class="changes-text">
+                {{
+                  "ADMIN_PANEL.TAG_MANAGEMENT.CHANGES_PREVIEW"
+                    | translate
+                      : {
+                          count: tagManagementTab.pendingChangesCount(),
+                          target: tagManagementTab.getTargetLabel()
+                        }
+                }}
+              </span>
+            } @else {
+              <span class="no-changes-text">
+                {{ "ADMIN_PANEL.TAG_MANAGEMENT.NO_CHANGES" | translate }}
+              </span>
+            }
+          </div>
+
+          <!-- Display toggle -->
+          <div class="display-toggle">
+            <div class="ui toggle checkbox">
+              <input
+                type="checkbox"
+                [checked]="tagManagementTab.showNamesInsteadOfEmojis()"
+                (change)="tagManagementTab.toggleDisplayMode()"
+                [disabled]="tagManagementTab.isSubmitting()"
+              />
+              <label>{{
+                "ADMIN_PANEL.TAG_MANAGEMENT.SHOW_NAMES" | translate
+              }}</label>
+            </div>
+          </div>
+        </div>
+
+        <div class="right-section">
+          <button
+            class="ui button"
+            [disabled]="
+              tagManagementTab.pendingChangesCount() === 0 ||
+              tagManagementTab.isSubmitting()
+            "
+            (click)="tagManagementTab.discardChanges()"
+          >
+            {{ "ADMIN_PANEL.TAG_MANAGEMENT.DISCARD_CHANGES" | translate }}
+          </button>
+          <button
+            class="ui primary button"
+            [class.loading]="tagManagementTab.isSubmitting()"
+            [disabled]="
+              tagManagementTab.pendingChangesCount() === 0 ||
+              tagManagementTab.isSubmitting()
+            "
+            (click)="tagManagementTab.applyChanges()"
+          >
+            {{ "ADMIN_PANEL.TAG_MANAGEMENT.APPLY_CHANGES" | translate }}
+          </button>
+        </div>
+      </div>
+    </div>
+  </hz-modal>
+</ng-container>
