+import {
+  computed,
+  ChangeDetectionStrategy,
+  Component,
+  Input,
+  Signal,
+} from "@angular/core";
+import { Store } from "@ngrx/store";
+import { Item } from "@shared/model/Item";
+import * as AdminPanelActions from "../../state/admin-panel.actions";
+import {
+  selectAdminPanelAddUserForm,
+  selectAdminPanelFirstLevelData,
+  selectAdminPanelHazuData,
+  selectAdminPanelProfileTypes,
+  selectAdminPanelProfileTemplates,
+  selectAdminPanelUsertypeData,
+} from "../../state/admin-panel.selectors";
+import { AddUserForm } from "../../state/admin-panel.state";
+
+@Component({
+  selector: "hz-add-user-tab",
+  templateUrl: "./add-user-tab.component.html",
+  styleUrls: ["./add-user-tab.component.scss"],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class AddUserTabComponent {
+  @Input() adminData: any;
+
+  form: Signal<AddUserForm>;
+  profileTypes: Signal<Item[]>;
+  profileTemplates: Signal<Item[]>;
+  usertypeData: Signal<Item[]>;
+  hazuData: Signal<Record<string, Item[]>>;
+  firstLevelData: Signal<Item[]>;
+  profileTypeOptions: Signal<Array<{ value: string; label: string }>>;
+  templateOptions: Signal<Array<{ value: string; label: string }>>;
+  usertypeOptions: Signal<Array<{ value: string; label: string }>>;
+  classLists: Signal<{ key: string; title: string; classes: Item[] }[]>;
+
+  constructor(private store: Store) {
+    this.form = this.store.selectSignal(selectAdminPanelAddUserForm);
+    this.profileTypes = this.store.selectSignal(selectAdminPanelProfileTypes);
+    this.profileTemplates = this.store.selectSignal(
+      selectAdminPanelProfileTemplates,
+    );
+    this.usertypeData = this.store.selectSignal(selectAdminPanelUsertypeData);
+    this.hazuData = this.store.selectSignal(selectAdminPanelHazuData);
+    this.firstLevelData = this.store.selectSignal(
+      selectAdminPanelFirstLevelData,
+    );
+
+    // Compute options reactively - show the Hazu's title, not the extracted tag name
+    this.profileTypeOptions = computed(() => {
+      return this.profileTypes().map((item) => ({
+        value: item.key,
+        label: item.titleText || "Unknown",
+      }));
+    });
+
+    this.templateOptions = computed(() => {
+      const selectedType = this.form().type;
+      if (!selectedType) {
+        return [];
+      }
+
+      const profileType = this.profileTypes().find(
+        (t) => t.key === selectedType,
+      );
+      if (!profileType) {
+        return [];
+      }
+
+      const profileTag = profileType.tags?.find((t) =>
+        t.startsWith("hz-config-profile-"),
+      );
+      if (!profileTag) {
+        return [];
+      }
+
+      return this.profileTemplates()
+        .filter((template) => template.tags?.includes(profileTag))
+        .map((template) => ({
+          value: template.key,
+          label: template.titleText || "Unknown Template",
+        }));
+    });
+
+    this.usertypeOptions = computed(() => {
+      return this.usertypeData().map((item) => ({
+        value: item.titleText || "",
+        label: item.titleText || "Unknown",
+      }));
+    });
+
+    // Compute class lists reactively to avoid re-creating arrays on every change detection
+    this.classLists = computed(() => {
+      const hazuDataObj = this.hazuData();
+      const firstLevelData = this.firstLevelData();
+      const result: { key: string; title: string; classes: Item[] }[] = [];
+
+      console.log(
+        "[AddUserTabComponent] classLists computed - firstLevelData:",
+        {
+          count: firstLevelData.length,
+          items: firstLevelData.map((item) => ({
+            key: item.key,
+            title: item.titleText,
+            tags: item.tags,
+          })),
+        },
+      );
+
+      // Get room items from first level data (e.g., "Classrooms")
+      const roomItems = firstLevelData.filter(
+        (item) => item.tags?.some((t) => t.startsWith("hz-config-room-")),
+      );
+
+      console.log("[AddUserTabComponent] classLists computed - roomItems:", {
+        count: roomItems.length,
+        items: roomItems.map((item) => ({
+          key: item.key,
+          title: item.titleText,
+        })),
+      });
+
+      console.log(
+        "[AddUserTabComponent] classLists computed - hazuDataObj keys:",
+        Object.keys(hazuDataObj),
+      );
+
+      roomItems.forEach((roomItem) => {
+        const classes = hazuDataObj[roomItem.key] || [];
+        console.log("[AddUserTabComponent] classLists computed - roomItem:", {
+          key: roomItem.key,
+          title: roomItem.titleText,
+          classesCount: classes.length,
+          classes: classes.map((c) => ({
+            key: c.key,
+            title: c.titleText,
+            tags: c.tags,
+          })),
+        });
+
+        if (classes.length > 0) {
+          const filteredClasses = classes.filter(
+            (c) => c.tags?.some((t) => t.startsWith("hz-config-class-")),
+          );
+          console.log(
+            "[AddUserTabComponent] classLists computed - filteredClasses for",
+            roomItem.key,
+            ":",
+            {
+              count: filteredClasses.length,
+              classes: filteredClasses.map((c) => ({
+                key: c.key,
+                title: c.titleText,
+              })),
+            },
+          );
+
+          result.push({
+            key: roomItem.key,
+            title: roomItem.titleText || "Unknown",
+            classes: filteredClasses,
+          });
+        }
+      });
+
+      console.log("[AddUserTabComponent] classLists computed - final result:", {
+        count: result.length,
+        result: result.map((r) => ({
+          key: r.key,
+          title: r.title,
+          classesCount: r.classes.length,
+          classes: r.classes.map((c) => ({ key: c.key, title: c.titleText })),
+        })),
+      });
+
+      return result;
+    });
+  }
+
+  updateForm(updates: Partial<AddUserForm>): void {
+    this.store.dispatch(
+      AdminPanelActions.updateAddUserForm({ formData: updates }),
+    );
+  }
+
+  onSubmit(): void {
+    const formData = this.form();
+    if (
+      !formData.type ||
+      !formData.template ||
+      !formData.firstName ||
+      !formData.lastName ||
+      !formData.email
+    ) {
+      return;
+    }
+
+    this.store.dispatch(AdminPanelActions.submitAddUser({ formData }));
+  }
+
+  getProfileTypeLabel(item: Item): string {
+    const profileTag = item.tags?.find((t) =>
+      t.startsWith("hz-config-profile-"),
+    );
+    if (profileTag) {
+      const type = profileTag.replace("hz-config-profile-", "");
+      return type.charAt(0).toUpperCase() + type.slice(1);
+    }
+    return item.titleText || "Unknown";
+  }
+
+  toggleClass(classId: string): void {
+    const currentClasses = { ...this.form().classes };
+    if (currentClasses[classId]) {
+      delete currentClasses[classId];
+    } else {
+      currentClasses[classId] = { selected: true, userType: "" };
+    }
+    this.updateForm({ classes: currentClasses });
+  }
+
+  updateClassUserType(classId: string, userType: string): void {
+    const currentClasses = { ...this.form().classes };
+    if (currentClasses[classId]) {
+      currentClasses[classId].userType = userType;
+      this.updateForm({ classes: currentClasses });
+    }
+  }
+
+  isClassSelected(classId: string): boolean {
+    return this.form().classes[classId]?.selected ?? false;
+  }
+
+  getClassUserType(classId: string): string {
+    return this.form().classes[classId]?.userType ?? "";
+  }
+}
