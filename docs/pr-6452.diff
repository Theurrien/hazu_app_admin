+  }
+
+  /**
+   * Check if there's a pending change for an item/usertype combination
+   */
+  hasPendingChange(itemId: string, usertype: string): boolean {
+    return this.pendingChanges().some(
+      (c) => c.itemId === itemId && c.usertype === usertype,
+    );
+  }
+
+  /**
+   * Get pending role for an item/usertype, or current role if no pending change
+   */
+  getPendingOrCurrentRole(item: Item, usertype: Item): ShareRole | null {
+    const usertypeId = this.getUsertypeIdentifier(usertype);
+    if (!usertypeId) return this.getRoleForUsertype(item, usertype);
+
+    const pending = this.pendingChanges().find(
+      (c) => c.itemId === item.key && c.usertype === usertypeId,
+    );
+    if (pending) {
+      return pending.newRole;
+    }
+    return this.getRoleForUsertype(item, usertype);
+  }
+
+  /**
+   * Get pending self-invite role, or current role if no pending change
+   */
+  getPendingOrCurrentSelfRole(item: Item): ShareRole | null {
+    const pending = this.pendingChanges().find(
+      (c) => c.itemId === item.key && c.usertype === "self",
+    );
+    if (pending) {
+      return pending.newRole;
+    }
+    return this.getSelfInviteRole(item);
+  }
+
+  /**
+   * Handle role selection from dropdown
+   * @param item The item being updated
+   * @param usertype The usertype for the role
+   * @param newRole The new role to set
+   * @param groupId The ID of the first-level group (category)
+   * @param templateId The ID of the parent template (for level 3 items)
+   */
+  onRoleSelect(
+    item: Item,
+    usertype: Item,
+    newRole: ShareRole,
+    groupId: string,
+    templateId?: string,
+  ): void {
+    // Close the dropdown after selection
+    this.closeAllDropdowns();
+
+    const usertypeId = this.getUsertypeIdentifier(usertype);
+    if (!usertypeId) return;
+
+    const currentRole = this.getRoleForUsertype(item, usertype);
+
+    // Normalize null to "none" for comparison
+    const normalizedCurrent = currentRole || "none";
+    const normalizedNew = newRole || "none";
+
+    // If selecting the same as current (not pending), remove any pending change
+    if (normalizedNew === normalizedCurrent) {
+      this.pendingChanges.update((changes) =>
+        changes.filter(
+          (c) => !(c.itemId === item.key && c.usertype === usertypeId),
+        ),
+      );
+      return;
+    }
+
+    // Update or add pending change
+    this.pendingChanges.update((changes) => {
+      const existing = changes.findIndex(
+        (c) => c.itemId === item.key && c.usertype === usertypeId,
+      );
+      const newChange: PendingChange = {
+        groupId,
+        templateId: templateId || item.key, // For level 2, templateId = itemId
+        itemId: item.key,
+        usertype: usertypeId,
+        oldRole: currentRole,
+        newRole,
+      };
+
+      if (existing >= 0) {
+        // Update existing
+        const updated = [...changes];
+        updated[existing] = newChange;
+        return updated;
+      } else {
+        // Add new
+        return [...changes, newChange];
+      }
+    });
+  }
+
+  /**
+   * Handle self-invite role selection from dropdown
+   * @param item The item being updated
+   * @param newRole The new role to set
+   * @param groupId The ID of the first-level group (category)
+   * @param templateId The ID of the parent template (for level 3 items)
+   */
+  onSelfInviteRoleSelect(
+    item: Item,
+    newRole: ShareRole,
+    groupId: string,
+    templateId?: string,
+  ): void {
+    // Close the dropdown after selection
+    this.closeAllDropdowns();
+
+    const currentRole = this.getSelfInviteRole(item);
+
+    // Normalize null to "none" for comparison
+    const normalizedCurrent = currentRole || "none";
+    const normalizedNew = newRole || "none";
+
+    // If selecting the same as current, remove any pending change
+    if (normalizedNew === normalizedCurrent) {
+      this.pendingChanges.update((changes) =>
+        changes.filter(
+          (c) => !(c.itemId === item.key && c.usertype === "self"),
+        ),
+      );
+      return;
+    }
+
+    // Update or add pending change
+    this.pendingChanges.update((changes) => {
+      const existing = changes.findIndex(
+        (c) => c.itemId === item.key && c.usertype === "self",
+      );
+      const newChange: PendingChange = {
+        groupId,
+        templateId: templateId || item.key, // For level 2, templateId = itemId
+        itemId: item.key,
+        usertype: "self",
+        oldRole: currentRole,
+        newRole,
+      };
+
+      if (existing >= 0) {
+        const updated = [...changes];
+        updated[existing] = newChange;
+        return updated;
+      } else {
+        return [...changes, newChange];
+      }
+    });
+  }
+
+  /**
+   * Get target label based on selected mode
+   */
+  getTargetLabel(): string {
+    const mode = this.selectedMode();
+    switch (mode) {
+      case "template":
+        return this.translateService.instant(
+          "ADMIN_PANEL.TAG_MANAGEMENT.CHANGES_TEMPLATES",
