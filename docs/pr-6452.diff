index 0000000000..4bdcaf3791
--- /dev/null
+++ b/angular/hazu-app/src/app/features/admin-panel/admin-panel-loader.service.ts
@@ -0,0 +1,114 @@
+import {
+  ApplicationRef,
+  ComponentRef,
+  Injectable,
+  Injector,
+  NgModuleRef,
+  Type,
+  ViewContainerRef,
+  createNgModule,
+} from "@angular/core";
+import { Item } from "@shared/model/Item";
+
+@Injectable({
+  providedIn: "root",
+})
+export class AdminPanelLoaderService {
+  private loadedModuleRef: NgModuleRef<any> | null = null;
+  private loadedComponent: Type<any> | null = null;
+  private currentComponentRef: ComponentRef<any> | null = null;
+
+  constructor(
+    private injector: Injector,
+    private appRef: ApplicationRef,
+  ) {}
+
+  async loadAdminPanelModule(): Promise<{
+    module: NgModuleRef<any>;
+    component: Type<any>;
+  }> {
+    if (this.loadedModuleRef && this.loadedComponent) {
+      return { module: this.loadedModuleRef, component: this.loadedComponent };
+    }
+
+    // Import the module and component
+    const { AdminPanelModule } = await import("./admin-panel.module");
+    const { AdminPanelViewComponent } = await import(
+      "./admin-panel-view/admin-panel-view.component"
+    );
+
+    // Create the module instance to ensure all providers and imports are available
+    this.loadedModuleRef = createNgModule(AdminPanelModule, this.injector);
+    this.loadedComponent = AdminPanelViewComponent;
+
+    return { module: this.loadedModuleRef, component: this.loadedComponent };
+  }
+
+  async renderAdminPanel(
+    viewContainerRef: ViewContainerRef,
+    baseItem: Item,
+  ): Promise<void> {
+    console.log(
+      "[AdminPanelLoader] renderAdminPanel called with baseItem:",
+      baseItem,
+    );
+
+    // Don't recreate if already showing the same item
+    if (
+      this.currentComponentRef &&
+      this.currentComponentRef.instance.baseItem?.id === baseItem.id &&
+      this.currentComponentRef.hostView.destroyed === false
+    ) {
+      console.log(
+        "[AdminPanelLoader] Component already showing same item, skipping",
+      );
+      return;
+    }
+
+    // Clear any existing component
+    if (this.currentComponentRef) {
+      console.log("[AdminPanelLoader] Destroying existing component");
+      this.appRef.detachView(this.currentComponentRef.hostView);
+      this.currentComponentRef.destroy();
+      this.currentComponentRef = null;
+    }
+    viewContainerRef.clear();
+
+    console.log("[AdminPanelLoader] Loading admin panel module...");
+    const { module, component } = await this.loadAdminPanelModule();
+    console.log("[AdminPanelLoader] Module loaded, creating component...");
+
+    // Create component with the lazy loaded module's injector
+    // This ensures all module dependencies are available
+    this.currentComponentRef = viewContainerRef.createComponent(component, {
+      ngModuleRef: module,
+    });
+    console.log(
+      "[AdminPanelLoader] Component created:",
+      this.currentComponentRef,
+    );
+
+    // Set the input - Angular will handle lifecycle hooks automatically
+    // The input must be set before the first change detection cycle
+    console.log("[AdminPanelLoader] Setting baseItem input:", baseItem);
+    this.currentComponentRef.setInput("baseItem", baseItem);
+
+    // Trigger change detection which will:
+    // 1. Initialize the component (constructor)
+    // 2. Set inputs (baseItem)
+    // 3. Call ngOnInit (which dispatches loadAdminData)
+    // 4. Run change detection on the component and its children
+    console.log("[AdminPanelLoader] Triggering change detection...");
+    this.currentComponentRef.changeDetectorRef.detectChanges();
+    console.log("[AdminPanelLoader] Change detection complete");
+  }
+
+  clearAdminPanel(viewContainerRef: ViewContainerRef): void {
+    if (this.currentComponentRef) {
+      this.appRef.detachView(this.currentComponentRef.hostView);
+      this.currentComponentRef.destroy();
+      this.currentComponentRef = null;
+    }
+    viewContainerRef.clear();
+  }
+}
